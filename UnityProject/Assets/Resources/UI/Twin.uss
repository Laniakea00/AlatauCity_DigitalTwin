/* qTwin platform style (qtwin.io): near-black, white type, Geologica, thin 1 px lines, floating panels over the 3D scene.
   Brand accent = qTwin red (logo / site), status colours = green / amber / red. No shadows, no gradients, no neon. */
.twin-root {
    --bg: #0a0a0a; --panel: rgba(16, 16, 16, 0.94); --panel-solid: #101010; --panel2: #1b1b1b; --panel3: #242424;
    --line: #2a2a2a; --line2: #3a3a3a;
    --text: #fdfcfc; --text2: #c3c3c3; --muted: #878787;
    --brand: #e0261b; --brand2: #ff3b2f;
    --ok: #34c759; --warn: #f5a623; --bad: #ff3b2f; --info: #7aa7ff; --sel: #d946ef;
    --gate: #2e63b0; --golden: #d9a621; --growing: #f27336; --green: #339e5c;
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: column; color: var(--text); font-size: 13px;
    -unity-font-definition: url("Fonts/Geologica-Regular.ttf");
}
.twin-root Label { margin: 0; padding: 0; white-space: normal; }
.fw-light { -unity-font-definition: url("Fonts/Geologica-Light.ttf"); }
.fw-medium { -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.fw-semi { -unity-font-definition: url("Fonts/Geologica-SemiBold.ttf"); }
.muted { color: var(--muted); }
.small { font-size: 11px; }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }

/* ---------- top bar (docked, like the qTwin platform) ---------- */
.header { height: 52px; flex-shrink: 0; flex-direction: row; align-items: center; background-color: var(--bg);
    border-bottom-width: 1px; border-bottom-color: var(--line); padding: 0 14px 0 12px; }
.logo { width: 33px; height: 29px; -unity-background-scale-mode: scale-to-fit; margin-right: 10px; }
.title { font-size: 16px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); letter-spacing: -0.2px; }
.place { flex-direction: row; align-items: center; margin-left: 14px; margin-right: 16px; padding: 4px 10px; border-radius: 14px;
    background-color: var(--panel2); border-width: 1px; border-color: var(--line); }
.place .pin { width: 6px; height: 6px; border-radius: 3px; background-color: var(--brand); margin-right: 7px; }
.place Label { font-size: 11px; color: var(--text2); }
.vsep { width: 1px; height: 52px; background-color: var(--line); }
.tabs { flex-direction: row; align-items: stretch; height: 52px; }
.tab { margin: 0; padding: 0 13px; height: 52px; background-color: rgba(0, 0, 0, 0); background-image: none; border-width: 0; border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0); border-radius: 0; color: var(--muted); font-size: 13px; -unity-text-align: middle-center; }
.tab:hover { color: var(--text); }
.tab.active { color: var(--text); border-bottom-color: var(--brand); }
.scenario-btn { flex-direction: row; align-items: center; height: 32px; padding: 0 12px; border-width: 1px; border-color: var(--line2); border-radius: 6px;
    background-color: var(--panel2); margin: 0 12px 0 0; }
.scenario-btn:hover { border-color: var(--text2); }
.scenario-btn .k { font-size: 11px; color: var(--muted); margin-right: 6px; }
.scenario-btn .v { font-size: 12px; }
.scenario-btn .chev { margin-left: 8px; }
.year-big { font-size: 26px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); letter-spacing: -0.8px; min-width: 62px; -unity-text-align: middle-right; }

/* ---------- buttons (square-ish like qtwin.io: primary = white fill, secondary = outline) ---------- */
.btn { margin: 0; padding: 6px 12px; background-color: var(--panel2); background-image: none; border-width: 1px; border-color: var(--line2);
    border-radius: 6px; color: var(--text); font-size: 13px; -unity-text-align: middle-center; }
.btn:hover { border-color: var(--text2); }
.btn:active { background-color: var(--panel3); }
.btn.primary { background-color: var(--text); color: #0a0a0a; border-color: var(--text); -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.btn.primary:hover { background-color: #e6e6e6; }
.btn.active { border-color: var(--text); }
.btn.small { padding: 3px 8px; font-size: 11px; }
.btn.ghost { background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); color: var(--text2); }
.btn.ghost:hover { background-color: var(--panel2); color: var(--text); }

/* ---------- scenario popup ---------- */
.popup { position: absolute; top: 56px; background-color: var(--panel-solid); border-width: 1px; border-color: var(--line2); border-radius: 10px; padding: 6px; width: 340px; }
.popup-item { padding: 9px 10px 9px 12px; border-radius: 6px; border-left-width: 2px; border-left-color: rgba(0, 0, 0, 0); }
.popup-item:hover { background-color: var(--panel2); }
.popup-item.active { background-color: var(--panel2); border-left-color: var(--brand); }
.popup-item .name { -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.popup-item .desc { color: var(--muted); font-size: 11px; margin-top: 3px; }

/* ---------- middle: 3D is full-bleed, panels float over it ---------- */
.middle { flex-grow: 1; }
.scene { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.right { position: absolute; top: 12px; right: 12px; bottom: 12px; width: 368px; }
.right .unity-scroll-view__content-container { padding: 0 0 4px 0; }
.right .unity-scroller--vertical { width: 6px; border-width: 0; background-color: rgba(0, 0, 0, 0); margin-left: 4px; }
.right .unity-scroller--vertical .unity-base-slider__dragger { background-color: var(--line2); border-radius: 3px; width: 4px; border-width: 0; left: 1px; }
.right .unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.right .unity-scroller__low-button, .right .unity-scroller__high-button { display: none; }

/* a block = one floating card of the right column (as in the platform: "Генерация станции", "Энергоблоки", ...) */
.block { background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 10px; padding: 12px 14px 14px 14px; margin-bottom: 8px; }
.block-head { flex-direction: row; align-items: center; margin-bottom: 10px; }
.block-title { font-size: 13px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); flex-grow: 1; }
.block-sub { font-size: 11px; color: var(--muted); }
.eyebrow { flex-direction: row; align-items: center; margin-bottom: 8px; }
.eyebrow .pin { width: 6px; height: 6px; border-radius: 3px; background-color: var(--brand); margin-right: 7px; }
.eyebrow Label { font-size: 10px; color: var(--text2); letter-spacing: 1.2px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }

.summary { font-size: 17px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); letter-spacing: -0.2px; }
.note { color: var(--muted); font-size: 11px; }

.kpi-grid { flex-direction: column; margin: 0 -3px; }
.kpi-row { flex-direction: row; }
.kpi { flex-basis: 0; flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 3px; padding: 9px 11px 10px 11px; background-color: var(--panel2); border-radius: 6px; }
.kpi .l { color: var(--muted); font-size: 11px; }
.kpi .v { font-size: 24px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); letter-spacing: -0.6px; margin-top: 3px; }
.kpi .v.accent { color: var(--text); }
.kpi.ok .v { color: var(--ok); }
.kpi.warn .v { color: var(--warn); }
.kpi.bad .v { color: var(--bad); }

.chart { height: 150px; margin: 2px 0 8px 0; }
.legend { flex-direction: row; flex-wrap: wrap; }
.legend-item { flex-direction: row; align-items: center; margin-right: 12px; margin-bottom: 4px; }
.block .legend-item { width: 50%; margin-right: 0; }
.legend-item Label { white-space: nowrap; }
.dot { width: 8px; height: 8px; border-radius: 2px; margin-right: 6px; }
.dot.round { border-radius: 4px; }

.table-head { flex-direction: row; padding: 0 8px 6px 8px; border-bottom-width: 1px; border-bottom-color: var(--line); }
.table-head Label { color: var(--muted); font-size: 11px; }
.trow { flex-direction: row; align-items: center; padding: 7px 8px; border-radius: 6px; margin-top: 2px; }
.trow.clickable:hover { background-color: var(--panel3); }
.trow.active { background-color: var(--panel2); }
.c-name { width: 110px; flex-direction: row; align-items: center; }
.c-num { flex-grow: 1; -unity-text-align: middle-right; }
.table-head .c-num { -unity-text-align: middle-right; }
.c-target { color: var(--muted); }

.district-head { flex-direction: row; align-items: center; margin-bottom: 8px; }
.district-head .big { font-size: 22px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); letter-spacing: -0.5px; }
.fact { flex-direction: row; justify-content: space-between; padding: 6px 0; border-bottom-width: 1px; border-bottom-color: var(--line); }
.fact .k { color: var(--muted); }
.fact .k { flex-shrink: 0; margin-right: 12px; }
.fact .v { -unity-text-align: middle-right; max-width: 230px; white-space: normal; flex-shrink: 1; }

/* ---------- bottom timeline (floating bar, like the platform toolbar) ---------- */
.bottom { position: absolute; left: 12px; right: 392px; bottom: 12px; height: 56px; flex-direction: row; align-items: center;
    background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 10px; padding: 0 16px 0 10px; }
.play { width: 86px; height: 34px; padding: 0; }
.slider { flex-grow: 1; height: 34px; margin: 0 14px; justify-content: center; }
.slider .track { height: 2px; border-radius: 1px; background-color: var(--line2); }
.slider .fill { position: absolute; left: 0; height: 2px; border-radius: 1px; background-color: var(--brand); top: 16px; }
.slider .handle { position: absolute; width: 14px; height: 14px; border-radius: 7px; background-color: var(--text); top: 10px; border-width: 0; }
.slider .tick { position: absolute; width: 1px; height: 6px; top: 14px; background-color: var(--muted); }
.slider .tick-label { position: absolute; top: -4px; font-size: 10px; color: var(--muted); width: 40px; -unity-text-align: upper-center; }
.bound { color: var(--muted); font-size: 12px; }

/* ---------- overlays in the 3D area ---------- */
.card { position: absolute; left: 12px; top: 12px; width: 320px; background-color: var(--panel);
    border-width: 1px; border-color: var(--line); border-radius: 10px; padding: 12px 14px; }
.card .head { flex-direction: row; align-items: center; margin-bottom: 4px; }
.card .head .t { font-size: 15px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); flex-grow: 1; }
.card .id { color: var(--muted); font-size: 11px; margin-bottom: 8px; }
.overlay-bl { position: absolute; left: 12px; bottom: 80px; flex-direction: column; align-items: flex-start; }
.badge { flex-direction: row; align-items: center; background-color: var(--panel); border-width: 1px; border-color: var(--line);
    border-radius: 14px; padding: 4px 10px; }
.badge .pin { width: 6px; height: 6px; border-radius: 3px; background-color: var(--warn); margin-right: 7px; }
.badge Label { color: var(--text2); font-size: 11px; }
.legend-3d { flex-direction: row; background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 14px; padding: 4px 10px 0 10px; margin-bottom: 6px; }
.hint { margin-bottom: 6px; background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 8px; padding: 6px 10px;
    color: var(--text2); font-size: 11px; max-width: 520px; transition-property: opacity; transition-duration: 0.6s; }
.hint.hidden { opacity: 0; }
.wip { padding: 0; }
.wip .t { font-size: 15px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); margin-bottom: 6px; }
.status { padding: 2px 8px; border-radius: 4px; font-size: 11px; background-color: var(--panel2); }
.status.ok { color: var(--ok); }
.status.warn { color: var(--warn); }
.status.bad { color: var(--bad); }
.status.muted { color: var(--muted); }

/* ---------- chips (layer toggles) ---------- */
.chips { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.chip { margin: 0 6px 6px 0; padding: 4px 10px; border-radius: 14px; border-width: 1px; border-color: var(--line2); background-color: rgba(0, 0, 0, 0);
    color: var(--muted); font-size: 12px; background-image: none; }
.chip:hover { color: var(--text); border-color: var(--text2); }
.chip.active { color: #0a0a0a; background-color: var(--text); border-color: var(--text); }
.net-row { flex-direction: row; align-items: center; padding: 5px 0; border-bottom-width: 1px; border-bottom-color: var(--line); }
.net-row .n { flex-grow: 1; }
.net-row .v { -unity-text-align: middle-right; min-width: 70px; }
.net-row .w { -unity-text-align: middle-right; min-width: 80px; color: var(--warn); }
.swatch { width: 14px; height: 4px; border-radius: 2px; margin-right: 8px; }

/* ---------- progress bars (plan vs fact) ---------- */
.stage-row { padding: 6px 0; border-bottom-width: 1px; border-bottom-color: var(--line); }
.stage-row .top { flex-direction: row; }
.stage-row .n { flex-grow: 1; font-size: 12px; }
.stage-row .v { font-size: 12px; -unity-text-align: middle-right; }
.bar { height: 6px; border-radius: 3px; background-color: var(--panel3); margin-top: 5px; }
.bar .p { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 3px; background-color: var(--line2); }
.bar .f { position: absolute; left: 0; top: 1px; bottom: 1px; border-radius: 2px; background-color: var(--text); }
.bar .f.behind { background-color: var(--bad); }
.bim-date { font-size: 22px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); }
.date-row { flex-direction: row; align-items: center; margin: 4px 0 8px 0; }
.date-row .slider { margin: 0 0 0 12px; }
.btn.wide { margin-top: 10px; padding: 9px 12px; }

/* ---------- map pins ---------- */
.pins { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.pin-wrap { position: absolute; flex-direction: row; align-items: center; }
.map-pin { border-width: 2px; border-color: rgba(10, 10, 10, 0.85); }
.map-pin.warn { border-color: var(--warn); border-width: 3px; }
.map-pin.bad { border-color: var(--bad); border-width: 3px; }
.map-pin.planned { border-color: rgba(253, 252, 252, 0.45); border-width: 1px; }
.pin-wrap.selected .map-pin { border-color: var(--text); border-width: 3px; }
.pin-label { margin-left: 6px; padding: 2px 7px; border-radius: 4px; font-size: 11px; background-color: var(--panel); border-width: 1px; border-color: var(--line); white-space: nowrap; }
.stage-row.clickable:hover { background-color: var(--panel3); }
.stage-row.active { background-color: var(--panel2); }
.fact.clickable:hover { background-color: var(--panel3); }

/* ---- M4 situational center */
.feed-row { flex-direction: row; align-items: flex-start; padding: 6px 4px; border-bottom-width: 1px; border-bottom-color: var(--line); border-radius: 4px; }
.feed-row.clickable:hover { background-color: var(--panel3); }
.feed-time { width: 40px; flex-shrink: 0; color: var(--muted); font-size: 11px; margin-top: 1px; }
.feed-text { flex-shrink: 1; flex-grow: 1; font-size: 12px; color: var(--text2); }
.feed-text.bad { color: var(--text); -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.cmp-cols { flex-direction: row; margin: 0 -4px; }
.cmp-col { flex-basis: 0; flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0 4px; padding: 9px 10px 10px 10px; background-color: var(--panel2); border-radius: 6px; }
.cmp-col .cap { font-size: 10px; letter-spacing: 1px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); margin-bottom: 4px; }
.cmp-col .t { font-size: 12px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.cmp-row { flex-direction: row; align-items: center; padding: 6px 0; border-bottom-width: 1px; border-bottom-color: var(--line); }
.cmp-row.head { padding-top: 0; }
.cmp-row.head Label { color: var(--muted); font-size: 11px; }
.cmp-row .k { flex-grow: 1; flex-shrink: 1; font-size: 12px; color: var(--text2); }
.cmp-row .y, .cmp-row .n { width: 92px; flex-shrink: 0; -unity-text-align: middle-right; font-size: 13px; }
.cmp-row .y.good { color: var(--ok); }
.cmp-row .n.worse { color: var(--bad); }
.src-row { padding: 7px 0; border-bottom-width: 1px; border-bottom-color: var(--line); }
.src-row .n { flex-grow: 1; font-size: 12px; }
.src-row .c { color: var(--muted); font-size: 11px; }
.src-row .smp { margin-left: 14px; margin-top: 2px; font-size: 11px; color: var(--text2); -unity-font-definition: url("Fonts/Geologica-Light.ttf"); }

/* ---- M5 AI layer: soft violet accent, no "terminator" look */
.ai-card { border-color: rgba(167, 139, 250, 0.32); }
.ai-card.latest { border-color: rgba(167, 139, 250, 0.7); background-color: rgba(24, 20, 36, 0.95); }
.ai-dot { width: 8px; height: 8px; border-radius: 4px; background-color: #a78bfa; margin-right: 7px; }
.ai-who { font-size: 11px; color: #c4b5fd; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); flex-grow: 1; letter-spacing: 0.6px; }
.ai-conf { font-size: 10px; color: #ddd6fe; background-color: rgba(167, 139, 250, 0.18); border-radius: 4px; padding: 2px 7px; }
.ai-text { font-size: 13px; color: var(--text); }
.ai-tool { font-size: 11px; color: #b8b0d8; margin-left: 2px; }
.ai-chip { font-size: 11px; }
.ai-chip:hover { border-color: #a78bfa; }
.ai-input { margin: 0; flex-shrink: 1; min-width: 0; }
.ai-input .unity-base-text-field__input, .ai-input .unity-text-field__input { background-color: var(--panel2); border-width: 1px; border-color: rgba(167, 139, 250, 0.45); border-radius: 6px; color: var(--text); padding: 6px 8px; font-size: 12px; min-height: 28px; }
.ai-input:focus .unity-base-text-field__input { border-color: #a78bfa; }
.ai-opt { padding: 9px 10px; border-radius: 6px; background-color: var(--panel2); margin-bottom: 6px; border-width: 1px; border-color: rgba(0, 0, 0, 0); }
.ai-opt.rec { border-color: rgba(167, 139, 250, 0.7); background-color: rgba(167, 139, 250, 0.08); }
.ai-opt .t { font-size: 12px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.ai-big { font-size: 20px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); letter-spacing: -0.4px; }
.ai-num { width: 18px; height: 18px; border-radius: 9px; background-color: rgba(167, 139, 250, 0.2); color: #ddd6fe; font-size: 10px; -unity-text-align: middle-center; margin-right: 8px; }
.tbar { height: 22px; background-color: var(--panel2); border-radius: 4px; overflow: hidden; }
.tseg { position: absolute; top: 0; bottom: 0; border-radius: 3px; justify-content: center; }
.tlab { font-size: 10px; color: #0a0a0a; margin-left: 5px; white-space: nowrap; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.ai-input .unity-base-text-field__input--placeholder { color: var(--muted); }

/* ---- presentation tour */
.tour-btn { margin-left: 8px; height: 34px; padding: 0 12px; }
.tour { position: absolute; top: 12px; left: 50%; translate: -60% 0; width: 560px; background-color: var(--panel); border-width: 1px; border-color: var(--line2);
        border-radius: 10px; padding: 12px 16px 10px 16px; }
.tour-step { font-size: 10px; letter-spacing: 1.2px; color: var(--brand); -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); margin-bottom: 4px; }
.tour-title { font-size: 22px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); letter-spacing: -0.5px; margin-bottom: 4px; }
.tour-text { font-size: 13px; color: var(--text2); }
.tour-track { height: 2px; background-color: var(--line2); margin-top: 10px; border-radius: 1px; }
.tour-bar { height: 2px; background-color: var(--brand); width: 0; border-radius: 1px; }

/* =====================================================================================================
   v2 shell — qTwin platform layout: top bar · icon rail · two floating columns · bottom dock
   ===================================================================================================== */
.twin-root { --panel: rgba(17, 17, 17, 0.93); --panel2: #1a1a1a; --panel3: #232323; --line: #262626; --line2: #343434; --text2: #c9c9c9; --muted: #8f8f8f; }
.icon { -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: #d6d6d6; flex-shrink: 0; }

.header { height: 60px; padding: 0 16px 0 14px; background-color: #0b0b0b; border-bottom-color: #1e1e1e; }
.logo { width: 38px; height: 33px; margin-right: 0; -unity-background-scale-mode: scale-to-fit; }
.hsep { width: 1px; height: 60px; background-color: #1e1e1e; margin: 0 16px; }
.place2 { flex-direction: row; align-items: center; }
.place2 .icon { -unity-background-image-tint-color: #f0c35a; margin-right: 10px; }
.pcol { flex-direction: column; }
.pcol .p1 { font-size: 13px; color: var(--text); -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.pcol .p2 { font-size: 11px; color: var(--muted); margin-top: 2px; }
.site-pill { position: absolute; left: 50%; translate: -50% 0; top: 13px; height: 34px; flex-direction: row; align-items: center; padding: 0 14px 0 12px;
    border-radius: 17px; background-color: #1c1c1c; border-width: 1px; border-color: #2c2c2c; }
.site-pill:hover { border-color: #4a4a4a; }
.site-pill .icon { margin-right: 8px; -unity-background-image-tint-color: #ffffff; }
.site-pill .v { font-size: 13px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.site-pill .chev { margin-left: 8px; }
.scenario-btn { height: 34px; border-radius: 17px; padding: 0 12px; background-color: #161616; border-color: #2c2c2c; }
.scenario-btn .icon { margin-right: 7px; -unity-background-image-tint-color: #9d9d9d; }
.year-big { font-size: 26px; margin-left: 14px; }
.hicon { width: 36px; height: 36px; border-radius: 8px; align-items: center; justify-content: center; margin-left: 2px; }
.hicon:hover { background-color: #1d1d1d; }
.hbadge { position: absolute; top: 4px; right: 3px; min-width: 15px; height: 15px; border-radius: 8px; background-color: var(--bad); color: #ffffff;
    font-size: 9px; -unity-text-align: middle-center; padding: 0 3px; -unity-font-definition: url("Fonts/Geologica-SemiBold.ttf"); }
.user { flex-direction: row; align-items: center; margin-left: 12px; }
.avatar { width: 34px; height: 34px; border-radius: 17px; background-color: #2a2d36; color: #e6e9f2; font-size: 12px; -unity-text-align: middle-center;
    -unity-font-definition: url("Fonts/Geologica-SemiBold.ttf"); margin-right: 10px; }

/* icon rail */
.rail { position: absolute; left: 0; top: 0; bottom: 0; width: 56px; background-color: #0b0b0b; border-right-width: 1px; border-right-color: #1e1e1e;
    flex-direction: column; align-items: stretch; padding: 10px 8px; }
.rail.open { width: 214px; }
.rail-btn { height: 40px; border-radius: 9px; flex-direction: row; align-items: center; padding: 0 10px; margin-bottom: 4px; }
.rail-btn .icon { -unity-background-image-tint-color: #8a8a8a; }
.rail-btn:hover { background-color: #191919; }
.rail-btn:hover .icon { -unity-background-image-tint-color: #ffffff; }
.rail-btn.active { background-color: #222222; }
.rail-btn.active .icon { -unity-background-image-tint-color: #ffffff; }
.rail-btn.toggle .icon { -unity-background-image-tint-color: #6d6d6d; }
.rail-label { display: none; margin-left: 12px; font-size: 13px; color: var(--text2); white-space: nowrap; }
.rail.open .rail-label { display: flex; }
.rail-btn.active .rail-label { color: var(--text); }
.rail-tip { display: none; position: absolute; left: 50px; top: 8px; padding: 4px 10px; border-radius: 6px; background-color: #222222; border-width: 1px; border-color: #333333;
    font-size: 12px; white-space: nowrap; color: var(--text); }
.rail-btn:hover .rail-tip { display: flex; }
.rail.open .rail-tip { display: none; }
.rail-line { height: 1px; background-color: #1e1e1e; margin: 6px 4px 10px 4px; }

/* two floating columns */
.col { position: absolute; top: 12px; bottom: 12px; width: 372px; }
.col-left { left: 68px; }
.col-right { right: 12px; }
.compact .col { width: 330px; }
.col .unity-scroll-view__content-container { padding: 0 0 4px 0; }
.col .unity-scroller--vertical { width: 6px; border-width: 0; background-color: rgba(0, 0, 0, 0); margin-left: 4px; }
.col .unity-scroller--vertical .unity-base-slider__dragger { background-color: #333333; border-radius: 3px; width: 4px; border-width: 0; left: 1px; }
.col .unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.col .unity-scroller__low-button, .col .unity-scroller__high-button { display: none; }

.block { background-color: var(--panel); border-color: #262626; border-radius: 12px; padding: 14px 16px 16px 16px; margin-bottom: 10px; }
.block-head { margin-bottom: 12px; }
.block-title { font-size: 16px; -unity-font-definition: url("Fonts/Geologica-SemiBold.ttf"); letter-spacing: -0.2px; }
.block-head .chev { margin-left: 8px; }
.block.collapsed .block-head { margin-bottom: 0; }
.kpi { background-color: #1b1b1b; border-radius: 8px; padding: 9px 12px 11px 12px; }
.kpi .l { font-size: 12px; color: #9a9a9a; }
.kpi .v { font-size: 25px; -unity-font-definition: url("Fonts/Geologica-Regular.ttf"); }

/* bottom dock: timeline + view tools, centred between the columns */
.dock { position: absolute; left: 452px; right: 396px; bottom: 12px; height: 54px; flex-direction: row; align-items: center; padding: 0 10px 0 8px;
    background-color: rgba(17, 17, 17, 0.94); border-width: 1px; border-color: #2a2a2a; border-radius: 12px; }
.compact .dock { left: 410px; right: 354px; }
.dock-play { width: 38px; height: 38px; border-radius: 9px; margin: 0; padding: 0; background-color: #f2f2f2; border-width: 0; background-image: none;
    align-items: center; justify-content: center; }
.dock-play:hover { background-color: #ffffff; }
.dock-play .icon { -unity-background-image-tint-color: #0a0a0a; }
.dsep { width: 1px; height: 26px; background-color: #2a2a2a; margin: 0 8px 0 12px; }
.dock-tool { width: 34px; height: 34px; border-radius: 8px; align-items: center; justify-content: center; }
.dock-tool:hover { background-color: #222222; }
.dock-tool .icon { -unity-background-image-tint-color: #a8a8a8; }
.dock-tool:hover .icon { -unity-background-image-tint-color: #ffffff; }
.over-dock { position: absolute; left: 452px; right: 396px; bottom: 74px; align-items: center; flex-direction: column; }
.compact .over-dock { left: 410px; right: 354px; }
.legend-3d { margin-bottom: 0; background-color: rgba(17, 17, 17, 0.88); border-color: #262626; }
.hint { margin-bottom: 6px; }
.demo-badge { position: absolute; bottom: 2px; left: 62px; flex-direction: row; padding: 1px 8px; border-radius: 8px; background-color: rgba(17, 17, 17, 0.55); }
.tour-on .demo-badge { display: none; }
.demo-badge Label { font-size: 9px; color: #7a7a7a; }
.card { left: 452px; top: 12px; }
.compact .card { left: 410px; }
.popup { top: 64px; border-radius: 12px; background-color: #121212; border-color: #2e2e2e; }
.tour { left: 50%; translate: -50% 0; top: 40px; }

/* journal cards (as the "Оперативный журнал" of the qTwin platform) */
.jcard { border-radius: 8px; padding: 10px 12px 10px 12px; margin-bottom: 8px; background-color: #1a1a1a; border-left-width: 3px; border-left-color: #3a3a3a; }
.jcard.bad { background-color: rgba(255, 59, 47, 0.11); border-left-color: #ff3b2f; }
.jcard.warn { background-color: rgba(245, 166, 35, 0.09); border-left-color: #f5a623; }
.jcard.ok { background-color: rgba(52, 199, 89, 0.08); border-left-color: #34c759; }
.jcard.info { background-color: rgba(122, 167, 255, 0.08); border-left-color: #7aa7ff; }
.jcard .jh { flex-direction: row; align-items: center; margin-bottom: 6px; }
.jcard .jh .icon { margin-right: 8px; }
.jcard .src { flex-grow: 1; font-size: 13px; -unity-font-definition: url("Fonts/Geologica-SemiBold.ttf"); }
.jbadge { font-size: 11px; padding: 2px 8px; border-radius: 6px; }
.jbadge.bad { color: #ff5a4f; background-color: rgba(255, 59, 47, 0.16); }
.jbadge.warn { color: #f5a623; background-color: rgba(245, 166, 35, 0.15); }
.jbadge.ok { color: #34c759; background-color: rgba(52, 199, 89, 0.14); }
.jbadge.info { color: #9cbcff; background-color: rgba(122, 167, 255, 0.14); }
.jcard .jt { font-size: 13px; color: #dcdcdc; }
.jcard .jf { flex-direction: row; align-items: center; margin-top: 8px; }
.jcard .jtime { flex-grow: 1; font-size: 11px; color: #8f8f8f; -unity-text-align: middle-right; }
.jbtn { flex-direction: row; align-items: center; padding: 3px 10px 3px 8px; border-radius: 12px; border-width: 1px; border-color: #3a3a3a; }
.jbtn:hover { border-color: #8a8a8a; }
.jbtn .icon { margin-right: 5px; }
.jbtn Label { font-size: 11px; color: #e0e0e0; }
.insight { padding: 10px 12px; margin-bottom: 8px; border-radius: 8px; background-color: #1a1a1a; border-left-width: 2px; border-left-color: #f5a623; }
.insight Label { font-size: 13px; color: #e2e2e2; white-space: normal; }
.insight-btn { flex-direction: column; align-items: stretch; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; margin-left: 0; margin-right: 0; -unity-text-align: upper-left; }
.insight-btn:hover { background-color: #222222; }
.insight .insight-go { font-size: 12px; color: #f5a623; margin-top: 4px; }
.wide-btn { height: 38px; border-radius: 8px; border-width: 1px; border-color: #2e2e2e; background-color: #161616; flex-direction: row; align-items: center; justify-content: center; margin-top: 4px; }
.wide-btn:hover { border-color: #5a5a5a; }
.wide-btn Label { font-size: 14px; margin-right: 8px; }
.wide-btn .icon { -unity-background-image-tint-color: #f0c35a; }
/* segmented meter (load / readiness) */
.meter { flex-direction: row; height: 34px; margin: 6px 0 4px 0; }
.meter .seg { flex-grow: 1; margin-right: 2px; border-radius: 2px; }
.meter-scale { flex-direction: row; justify-content: space-between; }
.meter-scale Label { font-size: 11px; color: #8f8f8f; }
.status-row { flex-direction: row; align-items: center; padding: 9px 10px; border-radius: 6px; margin-bottom: 2px; }
.status-row:hover { background-color: #1d1d1d; }
.status-row .n { flex-grow: 1; font-size: 13px; }
.status-row .s { font-size: 12px; white-space: nowrap; flex-shrink: 0; margin-left: 8px; }
.status-row .s.ok { color: #c9c9c9; }
.status-row .s.warn { color: #f5a623; }
.status-row .s.bad { color: #ff5a4f; }
.status-row.hl { background-color: rgba(245, 166, 35, 0.07); }
.rail-open .col-left { left: 226px; }
.rail-open .dock, .rail-open .over-dock { left: 610px; }
.rail-open .card { left: 610px; }
.meter-title { font-size: 15px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }

/* ---------------- landmarks: real projects of Alatau City (Investment projects tab, labels, passport) ---------------- */
.status.info { color: var(--info); }
.lm-pin-wrap { position: absolute; flex-direction: column; align-items: center; translate: -50% -100%; }
.lm-pin { flex-direction: row; align-items: center; padding: 4px 9px 4px 7px; border-radius: 6px; background-color: rgba(14, 14, 14, 0.92);
          border-width: 1px; border-color: #3a3a3a; }
.lm-pin:hover { border-color: #fdfcfc; background-color: rgba(28, 28, 28, 0.96); }
.lm-dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 6px; }
.lm-name { font-size: 12px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); white-space: nowrap; }
.lm-st { font-size: 10px; margin-left: 7px; padding: 1px 6px; border-radius: 3px; background-color: #1f1f1f; white-space: nowrap; }
.lm-st.ok { color: var(--ok); } .lm-st.warn { color: var(--warn); } .lm-st.info { color: var(--info); } .lm-st.muted { color: var(--muted); }
.lm-stem { width: 1px; height: 26px; background-color: rgba(253, 252, 252, 0.55); }
.lm-foot { width: 5px; height: 5px; border-radius: 3px; background-color: #fdfcfc; margin-top: -2px; }
.lm-pin-wrap.planned .lm-pin { background-color: rgba(14, 14, 14, 0.62); border-color: #2a2a2a; }
.lm-pin-wrap.planned .lm-name { color: #a9a9a9; }
.lm-pin-wrap.planned .lm-stem { background-color: rgba(253, 252, 252, 0.25); }
.lm-pin-wrap.hover .lm-pin { border-color: #d946ef; }
.lm-pin-wrap.selected .lm-pin { border-color: #d946ef; background-color: rgba(40, 14, 44, 0.95); }
.lm-pin-wrap.selected .lm-stem { background-color: #d946ef; }
.lm-pin-wrap.selected .lm-foot { background-color: #d946ef; }
.lm-pin-wrap.station .lm-pin { padding: 2px 7px 2px 5px; border-radius: 10px; }
.lm-pin-wrap.station .lm-name { font-size: 10px; }
.lm-pin-wrap.station .lm-dot { width: 6px; height: 6px; }
.lm-pin-wrap.station .lm-stem { height: 12px; }
.card.lm-card { width: 372px; }
.lm-chips { flex-direction: row; align-items: center; margin-bottom: 8px; }
.lm-chip { flex-direction: row; align-items: center; padding: 2px 8px; border-radius: 4px; background-color: var(--panel2); margin-right: 6px; font-size: 11px; }
.lm-purpose { color: var(--text2); margin-bottom: 10px; }
.lm-tl { margin: 2px 0 10px 0; }
.lm-tl Label { font-size: 11px; color: var(--muted); }
.lm-tl Label.ok { color: var(--ok); } .lm-tl Label.warn { color: var(--warn); }
.lm-bar { height: 6px; border-radius: 3px; background-color: var(--panel3); margin-top: 5px; overflow: hidden; }
.lm-fill { height: 6px; border-radius: 3px; background-color: var(--warn); }
.lm-fill.done { background-color: var(--ok); }
.lm-note { font-size: 10px; color: var(--muted); margin-top: 6px; }
.lm-btns { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.lm-btns .btn { margin-right: 6px; margin-bottom: 4px; }
.lm-row.selected { background-color: rgba(217, 70, 239, 0.12); }
.lm-pin-wrap.pin-hover .lm-pin { border-color: #fdfcfc; background-color: rgba(30, 30, 30, 0.97); }
/* «Мониторинг стройки»: larger marks with the way into the monitoring */
.lm-mon { display: none; font-size: 11px; margin-left: 9px; padding-left: 9px; border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.18); color: #e879f9; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); white-space: nowrap; }
.lm-pin-wrap.mon.has-mon .lm-mon { display: flex; }
/* the monitoring map: six marks; the two with a monitoring in magenta, the rest calm */
.lm-pin-wrap.mon .lm-st { margin-left: 8px; }
.lm-pin-wrap.mon .lm-pin { padding: 7px 12px 7px 10px; border-color: rgba(255, 255, 255, 0.28); }
.lm-pin-wrap.mon.has-mon .lm-pin { border-color: #d946ef; }
.lm-pin-wrap.mon .lm-name { font-size: 14px; }
.lm-pin-wrap.mon .lm-dot { width: 10px; height: 10px; border-radius: 5px; }
.lm-pin-wrap.mon .lm-stem { height: 60px; background-color: rgba(255, 255, 255, 0.55); }
.lm-pin-wrap.mon.has-mon .lm-stem { background-color: #d946ef; }
.lm-pin-wrap.mon .lm-foot { width: 9px; height: 9px; border-radius: 5px; background-color: #ffffff; }
.lm-pin-wrap.mon.has-mon .lm-foot { background-color: #d946ef; }
.lm-pin-wrap.mon.selected .lm-pin { background-color: rgba(30, 30, 30, 0.98); border-color: #ffffff; }
.monmap-group { font-size: 10px; letter-spacing: 1px; color: var(--muted); margin: 10px 0 2px 0; -unity-font-style: bold; }
.monmap-row { padding: 7px 6px 7px 6px; border-radius: 6px; }
.monmap-row:hover { background-color: rgba(255, 255, 255, 0.05); }
.lm-cap-tag.on { color: #e879f9; background-color: rgba(217, 70, 239, 0.14); }
.lm-pin-wrap.mon.pin-hover .lm-pin { background-color: rgba(40, 14, 44, 0.97); border-color: #fdfcfc; }


/* ---- presentation by zones (TwinTour): caption at the bottom right of the map column, above the dock; the passport stays on the left */
.tour.tour2 { top: auto; left: auto; translate: 0 0; right: 12px; bottom: 12px; width: 372px; padding: 12px 14px 10px 14px; border-radius: 12px;
    background-color: rgba(14, 14, 14, 0.96); border-color: #3a3a3a; }
.compact .tour.tour2 { width: 330px; }
.tour-zones { margin-top: 6px; flex-wrap: wrap; }
.tour2 .tour-title { font-size: 19px; }
.tour-on .over-dock { display: none; }
.tour-top { flex-direction: row; align-items: center; margin-bottom: 8px; }
.tour-zdot { width: 10px; height: 10px; border-radius: 5px; margin-right: 8px; }
.tour-zone { font-size: 11px; letter-spacing: 1.2px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); color: var(--text); }
.tour-count { font-size: 11px; color: var(--muted); }
.tour-segs { flex-direction: row; margin-bottom: 10px; }
.tour-seg { flex-grow: 1; flex-basis: auto; margin-right: 4px; padding-top: 5px; border-top-width: 3px; border-top-color: #2c2c2c; }   /* longer names (Growing, Summary) get more room */
.tour-seg Label { font-size: 10px; color: #6e6e6e; -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tour-seg.done { border-top-color: #6a6a6a; }
.tour-seg.done Label { color: #9a9a9a; }
.tour-seg.on { border-top-color: var(--brand); }
.tour-seg.on Label { color: var(--text); -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.tour2 .tour-text { font-size: 13px; color: var(--text2); margin-bottom: 4px; }
.tour-bullets { margin-top: 4px; }
.tour-bullet { flex-direction: row; align-items: flex-start; margin-top: 4px; }
.tour-bdot { width: 6px; height: 6px; border-radius: 3px; margin-top: 6px; margin-right: 8px; flex-shrink: 0; }
.tour-bullet Label { font-size: 12px; color: #d6d6d6; flex-shrink: 1; }

/* ---- landmark passport takes the right column's place (normal mode and presentation) */
.lm-open .col-right { display: none; }
.lm-open .card.lm-card { left: auto; right: 12px; top: 12px; width: 372px; }
.compact .lm-open .card.lm-card { width: 330px; }
.card.lm-card { overflow: hidden; }
.lm-src { margin-top: 6px; }
.lm-src Label { font-size: 10px; color: #8a8a8a; }
.lm-facts { margin-top: 4px; }
/* ---- presentation: the right column is free for the passport and the caption */
.tour-on .col-right { display: none; }
.tour-stepname { font-size: 14px; color: #e6e6e6; margin-bottom: 2px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
/* ---- construction: one chart (plan / fact / money) */
.bc-heads { flex-direction: row; margin-bottom: 8px; }
.bc-head { flex-grow: 1; flex-basis: 0; }
.bc-v { font-size: 22px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); color: #fafafa; }
.bc-l { font-size: 10px; color: #8f8f8f; margin-top: 1px; }
.bchart { margin-left: -4px; margin-right: -4px; }
/* ---- presentation: Silk Road map (full map, nothing else over it but the caption) */
.tour-map .pins, .tour-map .col-left, .tour-map .card, .tour-map .dock, .tour-map .over-dock { display: none; }
.silk-region { position: absolute; width: 160px; -unity-text-align: middle-center; font-size: 13px; letter-spacing: 4px; color: rgba(255, 255, 255, 0.28); -unity-font-definition: url("Fonts/Geologica-Light.ttf"); }
.silk-city { position: absolute; font-size: 11px; color: rgba(220, 225, 232, 0.85); }
.silk-alatau { position: absolute; width: 120px; -unity-text-align: upper-center; font-size: 15px; letter-spacing: 1.5px; color: #ffffff; -unity-font-definition: url("Fonts/Geologica-SemiBold.ttf"); }
.silk-title { position: absolute; font-size: 24px; color: #fafafa; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); }
.silk-legend { position: absolute; padding: 10px 12px; border-radius: 10px; background-color: rgba(10, 12, 16, 0.75); border-width: 1px; border-color: #2a2d33; }
.silk-leg { flex-direction: row; align-items: center; margin: 2px 0; }
.silk-leg Label { font-size: 12px; color: #d9d9d9; }
.silk-sw { width: 18px; height: 3px; border-radius: 2px; margin-right: 8px; }
/* ---- presentation callout: big figures over the map */
.tour-callout { position: absolute; top: 16px; left: 50%; translate: -50% 0; padding: 12px 20px 12px 20px; border-radius: 14px;
    background-color: rgba(12, 13, 16, 0.88); border-width: 1px; border-color: #30333a; align-items: flex-start; }
.co-title { font-size: 11px; letter-spacing: 1.6px; color: #a9adb3; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); margin-bottom: 6px; }
.co-row { flex-direction: row; }
.co-fig { margin-right: 30px; }
.co-v { font-size: 30px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); letter-spacing: -0.5px; }
.co-l { font-size: 11px; color: #9a9ea5; margin-top: -2px; }
.co-note { font-size: 11px; color: #7f848b; margin-top: 8px; }
/* ---- presentation: full-screen WOW steps (situation centre, forecast, AI) */
.tour-clean .col-left, .tour-clean .card, .tour-clean .dock, .tour-clean .over-dock, .tour-clean .col-right { display: none; }
.sit-sources { position: absolute; left: 76px; top: 22%; width: 300px; padding: 14px 16px 10px 16px; border-radius: 14px;
    background-color: rgba(12, 13, 16, 0.86); border-width: 1px; border-color: #30333a; }
.sit-h { font-size: 10px; letter-spacing: 1.6px; color: #a9adb3; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); margin-bottom: 8px; }
.sit-src { flex-direction: row; align-items: center; height: 30px; border-top-width: 1px; border-color: #1f2126; }
.sit-src > Label { font-size: 12px; color: #dfe2e6; flex-grow: 1; }
.sit-dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 10px; }
.sit-src > .sit-cnt { flex-grow: 0; font-size: 13px; color: #ffffff; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); -unity-text-align: middle-right; min-width: 50px; }
.sit-brief { position: absolute; right: 16px; top: 16px; width: 380px; padding: 16px 18px 16px 18px; border-radius: 16px;
    background-color: rgba(12, 13, 16, 0.92); border-width: 1px; border-color: #3a2a2a; }
.sit-title { font-size: 21px; color: #ffffff; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); white-space: normal; margin-bottom: 2px; }
.sit-where { font-size: 12px; color: #9a9ea5; margin-bottom: 10px; white-space: normal; }
.sit-row { margin-bottom: 8px; }
.sit-k { font-size: 10px; letter-spacing: 1.2px; color: #7f848b; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); margin-bottom: 2px; }
.sit-v { font-size: 13px; color: #e6e6e6; white-space: normal; }
.sit-status { font-size: 12px; color: #ff6a5a; margin-top: 4px; margin-bottom: 6px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.sit-status.ok { color: #4fd17a; }
.sit-solve { height: 52px; margin: 8px 0 0 0; border-radius: 26px; border-width: 0; background-image: none; background-color: #e5372b;
    color: #ffffff; font-size: 18px; letter-spacing: 3px; -unity-font-definition: url("Fonts/Geologica-SemiBold.ttf"); -unity-text-align: middle-center; }
.sit-solve:hover { background-color: #ff4a3c; }
.sit-steps { margin-top: 4px; }
.sit-step { font-size: 13px; color: #cfe9d6; height: 24px; -unity-text-align: middle-left; }
.sit-money { margin-top: 12px; padding-top: 10px; border-top-width: 1px; border-color: #26282d; }
.sit-bar-row { flex-direction: row; align-items: center; height: 26px; }
.sit-bar-k { width: 90px; font-size: 12px; color: #b9bdc3; }
.sit-bar { flex-grow: 1; height: 12px; border-radius: 6px; background-color: #1c1e22; margin-right: 10px; }
.sit-bar-f { height: 12px; border-radius: 6px; }
.sit-bar-v { width: 92px; font-size: 14px; color: #ffffff; -unity-text-align: middle-right; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
/* ---- forecast: energy 2034 */
.en-card { position: absolute; top: 16px; left: 50%; translate: -50% 0; width: 560px; padding: 14px 20px 14px 20px; border-radius: 16px;
    background-color: rgba(10, 12, 16, 0.90); border-width: 1px; border-color: #2c3340; }
.en-card.over { border-color: #8a2a24; }
.en-h { font-size: 10px; letter-spacing: 1.6px; color: #a9adb3; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); margin-bottom: 6px; }
.en-row { flex-direction: row; align-items: center; }
.en-year { font-size: 46px; color: #ffffff; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); width: 140px; letter-spacing: -1px; }
.en-gauge { width: 170px; height: 92px; margin-right: 18px; }
.en-pct { position: absolute; left: 0; right: 0; bottom: 4px; -unity-text-align: lower-center; font-size: 26px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.en-figs { flex-grow: 1; }
.en-v { font-size: 20px; color: #ffffff; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.en-l { font-size: 11px; color: #8d9299; margin-top: -2px; }
.en-chart { height: 74px; margin-top: 10px; }
.en-x { flex-direction: row; }
.en-xl { flex-grow: 1; flex-basis: 0; -unity-text-align: upper-center; font-size: 10px; color: #7f848b; }
.en-status { font-size: 14px; margin-top: 10px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); white-space: normal; }
.en-warn { font-size: 13px; color: #ffc04a; margin-top: 4px; white-space: normal; }
.en-fix { font-size: 13px; color: #6fe39a; margin-top: 4px; white-space: normal; }
/* ---- AI assistant: question bubble, working chips, answer card, 10-minute ring */
.aiw-bubble { position: absolute; top: 18px; left: 50%; translate: -50% 0; width: 640px; padding: 16px 22px 16px 22px; border-radius: 18px;
    background-color: rgba(14, 12, 22, 0.92); border-width: 1px; border-color: #4b3f7a; }
.aiw-bh { font-size: 10px; letter-spacing: 1.6px; color: #b3a6f5; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); margin-bottom: 6px; }
.aiw-q { font-size: 28px; color: #ffffff; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); }
.aiw-cursor { color: #a98cff; margin-left: 2px; }
.aiw-chips { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.aiw-chip { flex-direction: row; align-items: center; height: 28px; padding: 0 12px 0 10px; margin: 0 8px 6px 0; border-radius: 14px; background-color: #221d36; }
.aiw-chip > Label { font-size: 12px; color: #d9d3f5; }
.aiw-chip.done { background-color: #1b2a22; }
.aiw-chip.done > Label { color: #cfeedd; }
.aiw-chip .aiw-mark { width: 16px; margin-right: 6px; color: #a98cff; -unity-text-align: middle-center; }
.aiw-chip.done > .aiw-mark { color: #4fd17a; }
.aiw-legend { font-size: 12px; color: #c8ccd2; margin-top: 4px; }
.aiw-result { position: absolute; left: 76px; top: 210px; width: 330px; padding: 16px 18px 16px 18px; border-radius: 16px;
    background-color: rgba(14, 12, 22, 0.92); border-width: 1px; border-color: #4b3f7a; }
.aiw-big { font-size: 48px; color: #ffffff; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); letter-spacing: -1px; margin-bottom: -4px; }
.aiw-sub { font-size: 13px; color: #c9c2ee; margin-bottom: 10px; white-space: normal; }
.aiw-fig { flex-direction: row; justify-content: space-between; height: 26px; align-items: center; border-top-width: 1px; border-color: #2a2540; }
.aiw-fk { font-size: 12px; color: #9a96b0; }
.aiw-fv { font-size: 14px; color: #ffffff; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.aiw-note { font-size: 11px; color: #7f7b94; margin-top: 8px; white-space: normal; }
.aiw-ring { position: absolute; width: 140px; -unity-text-align: middle-center; font-size: 12px; color: #ffffff; padding: 3px 8px 3px 8px;
    border-radius: 10px; background-color: rgba(120, 95, 230, 0.85); -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.sit-save { font-size: 20px; color: #4fd17a; margin-top: 6px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }

/* the «growth by use» chart: in the presentation only in the steps about the growth of the whole city */
.tour-on .gfa-block { display: none; }
.tour-on.tour-gfa .gfa-block { display: flex; }
/* construction: money by source in the shown year, one thin bar under the chart */
.bc-src { flex-direction: row; height: 6px; border-radius: 3px; overflow: hidden; margin-top: 10px; }
.bc-seg { height: 6px; margin-right: 1px; }
.bc-srcleg { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.bc-si { flex-direction: row; align-items: center; margin-right: 12px; margin-bottom: 2px; }
.bc-si Label { font-size: 10px; color: #a3a3a3; white-space: nowrap; }
.bc-sdot { width: 7px; height: 7px; border-radius: 4px; margin-right: 5px; }
/* situation centre: the twin's own line under the sources (matching → confirmed) */
.sit-sys { font-size: 12px; color: #ffb35a; margin-top: 8px; height: 18px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.sit-sys.ok { color: #4fd17a; }
/* ---- presentation: the step dashboard (right column, above the caption) */
.story { position: absolute; right: 12px; bottom: 230px; width: 372px; padding: 12px 14px 12px 14px; border-radius: 12px;
    background-color: rgba(14, 14, 14, 0.94); border-width: 1px; border-color: #343434; }
.compact .story { width: 330px; }
.story-eye { font-size: 10px; letter-spacing: 1.4px; color: #9a9a9a; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); margin-bottom: 4px; }
.story-head { font-size: 16px; color: #f4f4f4; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); margin-bottom: 8px; white-space: normal; }
.story-kpis { flex-direction: row; margin: 0 -3px 2px -3px; }
.story-kpi { flex-basis: 0; flex-grow: 1; min-width: 0; margin: 0 3px; padding: 7px 9px 8px 9px; border-radius: 6px; background-color: #1b1b1b; }
.story-v { font-size: 20px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); letter-spacing: -0.4px; }
.story-l { font-size: 10px; color: #8f8f8f; margin-top: 1px; white-space: normal; }
.story-rows { margin-top: 8px; }
.story-row { margin-top: 5px; }
.story-row.dim { opacity: 0.32; }
.story-rtop { flex-direction: row; align-items: center; }
.story-chip { width: 9px; height: 9px; border-radius: 2px; margin-right: 8px; flex-shrink: 0; }
.story-rn { font-size: 12px; color: #dcdcdc; flex-grow: 1; flex-shrink: 1; }
.story-rv { font-size: 12px; color: #ffffff; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); -unity-text-align: middle-right; margin-left: 8px; }
.story-bar { height: 4px; border-radius: 2px; background-color: #262626; margin: 3px 0 0 17px; overflow: hidden; }
.story-fill { height: 4px; border-radius: 2px; }
.story-note { font-size: 10px; color: #7d7d7d; margin-top: 8px; white-space: normal; }
.tour-nocard .card { display: none; }

/* video mode (F6): the caption without the presenter's controls */
.tour.tour2.video > .row { display: none; }
.tour.tour2.video > .note { display: none; }

/* ---------- Smart City: camera feed (stub), notifications, toasts ---------- */
.feed { height: 194px; border-radius: 8px; overflow: hidden; background-color: #050505; border-width: 1px; border-color: #262626; }
.compact .feed { height: 172px; }
.feed-big { height: 196px; }
.feed-img { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.feed-over { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 7px 9px; }
.feed-top { flex-direction: row; align-items: center; }
.feed-rec { width: 9px; height: 9px; margin-right: 8px; }
.feed-id { font-size: 11px; color: #ffffff; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); letter-spacing: 0.4px; background-color: rgba(0, 0, 0, 0.45); padding: 1px 5px; border-radius: 3px; }
.feed-clock { font-size: 10px; color: #e6e6e6; background-color: rgba(0, 0, 0, 0.45); padding: 1px 5px; border-radius: 3px; }
.feed-place { position: absolute; left: 9px; bottom: 7px; font-size: 11px; color: #f0f0f0; background-color: rgba(0, 0, 0, 0.5); padding: 1px 6px; border-radius: 3px; }
.feed-stub { position: absolute; right: 9px; bottom: 7px; font-size: 9px; letter-spacing: 1px; color: #ffcf6a; background-color: rgba(0, 0, 0, 0.55); padding: 1px 6px; border-radius: 3px; }
.feed.offline .feed-place { color: #ff6b61; }
.feed-tour { position: absolute; right: 12px; top: 12px; width: 372px; padding: 12px 14px 12px 14px; border-radius: 12px;
    background-color: rgba(16, 16, 16, 0.94); border-width: 1px; border-color: #262626; }
.compact .feed-tour { width: 330px; }

.toast-host { position: absolute; top: 10px; left: 0; right: 0; align-items: center; }
.toast { width: 400px; margin: 0; opacity: 0; translate: 0 -12px; background-color: #151515; border-width: 1px; border-color: #2e2e2e; border-left-width: 3px;
    transition-property: opacity, translate; transition-duration: 0.35s, 0.35s; }
.toast.show { opacity: 1; translate: 0 0; }
.tour-on .toast-host { top: 10px; }
.toast-host .jcard.toast { background-color: rgb(21, 21, 21); }
.toast-host .jcard.toast.show { opacity: 1; }

.notif-pop { position: absolute; top: 6px; width: 400px; max-height: 640px; padding: 12px 12px 10px 12px; border-radius: 12px;
    background-color: #121212; border-width: 1px; border-color: #2e2e2e; }
.notif-list { flex-shrink: 1; max-height: 470px; }
.notif-list .jcard { margin-right: 4px; }
.notif-list .unity-scroller--vertical { width: 6px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.notif-list .unity-scroller--vertical .unity-base-slider__dragger { background-color: #333333; border-radius: 3px; width: 4px; border-width: 0; left: 1px; }
.notif-list .unity-scroller__low-button, .notif-list .unity-scroller__high-button { display: none; }

/* ---------- production capacity in passports, economy tab ---------- */
.lm-cap { margin-top: 10px; padding: 10px 12px 10px 12px; border-radius: 8px; background-color: #1a1a1a; }
.lm-cap-h { font-size: 10px; letter-spacing: 1.2px; color: #9a9a9a; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.lm-cap-tag { font-size: 10px; color: #34c759; padding: 0 6px; border-radius: 6px; background-color: rgba(52, 199, 89, 0.12); }
.lm-cap-tag.est { color: #f5a623; background-color: rgba(245, 166, 35, 0.12); }
.lm-cap-v { font-size: 22px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); letter-spacing: -0.4px; margin-top: 4px; }
.lm-cap-line { color: #c9c9c9; margin-top: 2px; }
.eco-h { font-size: 12px; color: #9a9a9a; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.story-row.clickable:hover { background-color: #1d1d1d; }

/* presentation mode 2: the navigator (TwinTourNav) — a bar at the top of the map and the list of steps, districts and objects under it */
.tnav { position: absolute; top: 10px; left: 50%; translate: -50% 0; flex-direction: row; align-items: center; padding: 6px 6px 6px 12px;
    background-color: var(--panel); border-width: 1px; border-color: var(--line2); border-radius: 12px; }
.tnav .btn { margin-left: 6px; }
.tnav-ic { margin-right: 8px; -unity-background-image-tint-color: #ffffff; }
.tnav-now { font-size: 13px; color: var(--text); -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); max-width: 360px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 6px; }
.tnav-pop { position: absolute; top: 58px; left: 50%; translate: -50% 0; width: 460px; max-height: 72%; padding: 8px 6px 8px 8px;
    background-color: var(--panel-solid); border-width: 1px; border-color: var(--line2); border-radius: 12px; }
.tnav-scroll { flex-grow: 1; flex-shrink: 1; }
.tnav-scroll .unity-scroller--vertical { width: 6px; border-width: 0; background-color: rgba(0, 0, 0, 0); margin-left: 4px; }
.tnav-scroll .unity-scroller--vertical .unity-base-slider__dragger { background-color: var(--line2); border-radius: 3px; width: 4px; border-width: 0; left: 1px; }
.tnav-scroll .unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.tnav-scroll .unity-scroller__low-button, .tnav-scroll .unity-scroller__high-button { display: none; }
.tnav-head { flex-direction: row; align-items: center; margin: 10px 0 4px 6px; }
.tnav-head Label { font-size: 10px; letter-spacing: 1.2px; color: var(--muted); -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.tnav-dot { width: 7px; height: 7px; border-radius: 4px; margin-right: 8px; flex-shrink: 0; }
.tnav-chips { flex-direction: row; flex-wrap: wrap; margin: 2px 0 2px 2px; }
.tnav-chips .btn { margin: 2px 4px 2px 0; }
.tnav-item { flex-direction: row; align-items: center; padding: 7px 10px 7px 10px; border-radius: 6px; border-left-width: 2px; border-left-color: rgba(0, 0, 0, 0); }
.tnav-item:hover { background-color: var(--panel2); }
.tnav-item.on { background-color: var(--panel2); border-left-color: var(--brand); }
.tnav-n { width: 22px; font-size: 11px; color: var(--muted); }
.tnav-t { font-size: 13px; color: #e6e6e6; flex-shrink: 1; }
.tnav-item.on .tnav-t { -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); color: var(--text); }
.tnav-on .toast-host, .tnav-on.tour-on .toast-host { top: 62px; }
.tnav-on .tour-callout { top: 62px; }

/* language: a globe button with the current code in the header, the menu under it */
.lang-btn { flex-direction: row; width: auto; padding: 0 9px 0 9px; }
.lang-code { font-size: 11px; color: var(--muted); margin-left: 5px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.lang-btn:hover .lang-code { color: var(--text); }
.lang-pop .popup-item.row { flex-direction: row; align-items: center; justify-content: space-between; }
.lang-pop .popup-item .name { white-space: nowrap; flex-shrink: 0; }
.lang-tag { font-size: 11px; color: var(--muted); }

/* ---------- inside Iconic Complex (IconicInterior): floor panel in place of the passport ---------- */
.ii-card { position: absolute; right: 12px; top: 12px; width: 392px; max-height: 88%; background-color: var(--panel); border-width: 1px; border-color: var(--line);
    border-radius: 10px; padding: 12px 14px 12px 14px; overflow: hidden; }
.compact .ii-card { width: 350px; }
.tour-on .ii-card { max-height: 64%; }
.ii-card .head { flex-direction: row; align-items: center; margin-bottom: 4px; }
.ii-card .head .t { font-size: 15px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); flex-grow: 1; }
.ii-card .id { color: var(--muted); font-size: 11px; margin-bottom: 8px; }
.ii-body { flex-direction: row; margin-top: 2px; }
.ii-stack { width: 112px; flex-shrink: 0; margin-right: 12px; padding: 2px 0 2px 0; }
.ii-row { height: 5px; margin-bottom: 1px; flex-direction: row; justify-content: flex-end; align-items: center; }
.ii-bar { height: 5px; border-radius: 1px; }
.ii-row:hover .ii-bar { border-width: 1px; border-color: var(--text); }
.ii-row.cur .ii-bar { height: 7px; border-width: 1px; border-color: var(--sel); }
.ii-cur { font-size: 10px; color: var(--sel); margin-right: 5px; height: 14px; -unity-text-align: middle-right; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.ii-right { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.ii-step { flex-direction: row; align-items: center; padding: 4px 0 4px 0; border-bottom-width: 1px; border-bottom-color: var(--line); }
.ii-dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 8px; border-width: 1px; border-color: var(--line2); flex-shrink: 0; }
.ii-dot.now { border-color: var(--text); }
.ii-sn { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 12px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ii-sw { font-size: 11px; color: var(--text2); white-space: nowrap; margin-left: 6px; flex-shrink: 0; }
.ii-sw.warn { color: var(--warn); }
.ii-legend { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.ii-legend .legend-item { margin-right: 10px; }
.ii-on .story { visibility: hidden; }

/* ---------- construction monitoring of Iconic Complex (IconicMonitor): the city dims, a QazTWIN-style window opens ---------- */
.mon-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.74); }
.mon-win { position: absolute; left: 3%; right: 3%; top: 4%; bottom: 4%; background-color: #0a0a0a; border-width: 1px; border-color: #2e2e2e;
    border-radius: 12px; overflow: hidden; flex-direction: column; }
.mon-head { height: 52px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 0 12px 0 14px; border-bottom-width: 1px; border-bottom-color: var(--line); }
.mon-logo { width: 26px; height: 26px; border-radius: 13px; border-width: 3px; border-color: var(--brand); margin-right: 12px; }
.mon-pill { flex-direction: row; align-items: center; padding: 6px 14px 6px 12px; border-radius: 16px; background-color: var(--panel2); border-width: 1px; border-color: var(--line2); }
.mon-pill Label { margin-left: 7px; font-size: 13px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.mon-body { flex-grow: 1; position: relative; overflow: hidden; }
.mon-photo { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.mon-pin { position: absolute; translate: -50% -100%; flex-direction: column; align-items: center; }
.mon-pin Label { background-color: rgba(250, 250, 250, 0.95); color: #111111; font-size: 12px; padding: 5px 10px 5px 10px; border-radius: 6px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.mon-stem { width: 2px; height: 30px; background-color: rgba(255, 255, 255, 0.9); }
.mon-hud { margin-top: 8px; font-size: 10px; color: rgba(255, 255, 255, 0.85); letter-spacing: 0.8px; background-color: rgba(0, 0, 0, 0.55); padding: 3px 8px 3px 8px; border-radius: 4px; }
.mon-col { position: absolute; top: 12px; bottom: 76px; overflow: hidden; }
.mon-tab-g .mon-left { bottom: 50%; }
.mon-left { left: 12px; width: 330px; }
.mon-right { right: 12px; width: 410px; }
.mon-card { background-color: rgba(16, 16, 16, 0.94); border-width: 1px; border-color: var(--line); border-radius: 10px; padding: 12px 14px 12px 14px; margin-bottom: 10px; flex-shrink: 0; }
.mon-row { flex-direction: row; align-items: center; }
.mon-title { font-size: 15px; margin-left: 8px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.mon-bar { height: 4px; background-color: #2a2a2a; }
.mon-fill { height: 4px; background-color: #5b8def; }
.mon-mark { position: absolute; top: -3px; width: 2px; height: 10px; background-color: #ffffff; }
.mon-chart { height: 120px; margin-top: 10px; position: relative; }
.mon-legend { flex-direction: row; justify-content: center; margin-top: 2px; }
.mon-legend Label { font-size: 10px; margin: 0 8px 0 8px; color: var(--text2); }
.mon-para { white-space: normal; color: var(--text2); font-size: 12px; margin-top: 6px; }
.mon-table { margin-top: 8px; }
.mon-tr { flex-direction: row; align-items: flex-start; padding: 6px 0 6px 8px; border-left-width: 2px; border-left-color: rgba(0, 0, 0, 0); border-bottom-width: 1px; border-bottom-color: var(--line); }
.mon-tr.ok { border-left-color: var(--ok); }
.mon-tr.warn { border-left-color: var(--warn); }
.mon-tr.bad { border-left-color: var(--bad); }
.mon-th .mon-td { color: var(--muted); font-size: 10px; }
.mon-td.w { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.mon-td.n { width: 48px; -unity-text-align: upper-right; font-size: 12px; flex-shrink: 0; }
.mon-td.d { width: 62px; -unity-text-align: upper-right; font-size: 12px; flex-shrink: 0; }
.mon-td.d.ok { color: var(--ok); }
.mon-td.d.warn { color: var(--warn); }
.mon-td.d.bad { color: var(--bad); }
.mon-work { font-size: 12px; white-space: normal; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.mon-src { font-size: 10px; color: var(--muted); white-space: normal; }
.mon-tag { align-self: flex-start; font-size: 10px; padding: 1px 6px 1px 6px; border-radius: 4px; background-color: #2a2a2a; color: var(--text2); }
.mon-feed-img { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.mon-feed-over { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.mon-tools { position: absolute; bottom: 12px; left: 50%; translate: -50% 0; flex-direction: row; padding: 4px; border-radius: 10px; background-color: rgba(16, 16, 16, 0.94); border-width: 1px; border-color: var(--line); }
.mon-tool { width: 34px; height: 34px; align-items: center; justify-content: center; border-radius: 7px; }
.mon-ai { align-items: flex-start; }
.mon-ai .dot { margin-top: 4px; margin-right: 6px; flex-shrink: 0; }
.mon-tool.on { background-color: var(--panel3); border-bottom-width: 2px; border-bottom-color: var(--info); }
/* construction monitoring: tabs, views, the 4D timeline, the work schedule, the site cameras */
.mon-tab:hover { background-color: #202020; }
.mon-head .mon-pill { margin-right: 10px; }
.mon-top { position: absolute; top: 12px; left: 354px; right: 434px; align-items: center; }
.mon-seg { flex-direction: row; padding: 3px; border-radius: 9px; background-color: rgba(16, 16, 16, 0.94); border-width: 1px; border-color: var(--line2); }
.mon-seg .btn { margin: 0 1px 0 1px; border-color: rgba(0, 0, 0, 0); background-color: rgba(0, 0, 0, 0); color: var(--text2); }
.mon-seg .btn:hover { background-color: var(--panel2); color: var(--text); }
.mon-seg .btn.active { background-color: var(--text); color: #0a0a0a; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.mon-fact { flex-direction: row; justify-content: space-between; align-items: flex-start; margin-top: 6px; }
.mon-fact .k { font-size: 11px; color: var(--muted); flex-shrink: 0; }
.mon-fact .v { font-size: 12px; color: var(--text); -unity-text-align: upper-right; white-space: normal; flex-shrink: 1; margin-left: 10px; }
.mon-fact .v.warn { color: var(--warn); }
.mon-fact .v.bad { color: var(--bad); }
.mon-strip { position: absolute; left: 12px; right: 12px; bottom: 12px; height: 52px; flex-direction: row; align-items: center; padding: 0 10px 0 10px; border-radius: 10px;
    background-color: rgba(16, 16, 16, 0.96); border-width: 1px; border-color: var(--line); }
.mon-play { width: 34px; height: 34px; border-radius: 17px; padding: 0; margin: 0 10px 0 0; align-items: center; justify-content: center; background-color: var(--panel3); background-image: none; border-width: 1px; border-color: var(--line2); }
.mon-play:hover { border-color: var(--text2); }
.mon-sdate { width: 160px; margin-right: 8px; }
.mon-sdate-v { font-size: 16px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.mon-track { flex-grow: 1; height: 40px; margin: 0 16px 0 6px; position: relative; }
.mon-tick { position: absolute; bottom: 0; translate: -50% 0; font-size: 9px; color: var(--muted); }
.mon-strip > .btn { margin-right: 8px; }
.mon-g { position: absolute; left: 12px; right: 12px; bottom: 74px; max-height: 60%; background-color: rgba(14, 14, 14, 0.96); border-width: 1px; border-color: var(--line);
    border-radius: 10px; padding: 10px 12px 8px 12px; overflow: hidden; }
.mon-g-head { margin-bottom: 6px; flex-shrink: 0; }
.mon-g-head .legend-item { margin-left: 12px; margin-right: 0; margin-bottom: 0; }
.mon-g-list { flex-shrink: 1; overflow: hidden; }
.mon-g-row { flex-direction: row; align-items: center; height: 21px; flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.045); }
.mon-g-row.sel { background-color: rgba(91, 141, 239, 0.16); }
.mon-g-th { height: 22px; border-bottom-color: var(--line); }
.mon-g-th Label { font-size: 10px; color: var(--muted); }
.mon-g-name { width: 260px; flex-shrink: 0; flex-direction: row; align-items: center; overflow: hidden; padding-left: 4px; }
.mon-g-row .mon-g-name:hover { background-color: rgba(255, 255, 255, 0.05); }
.mon-g-code { width: 30px; font-size: 10px; color: var(--muted); flex-shrink: 0; }
.mon-g-label { font-size: 11px; color: var(--text); white-space: nowrap; }
.mon-g-n { width: 46px; flex-shrink: 0; font-size: 11px; -unity-text-align: middle-right; color: var(--text2); }
.mon-g-d { width: 66px; flex-shrink: 0; font-size: 11px; -unity-text-align: middle-right; margin-right: 12px; color: var(--muted); }
.mon-g-d.ok { color: var(--ok); }
.mon-g-d.warn { color: var(--warn); }
.mon-g-d.bad { color: var(--bad); }
.mon-g-bars { flex-grow: 1; align-self: stretch; position: relative; margin-left: 12px; }
.mon-g-year { position: absolute; top: 4px; font-size: 10px; color: var(--text2); margin-left: 3px; }
.mon-g-q { position: absolute; top: 5px; font-size: 9px; color: var(--muted); margin-left: 3px; }
.mon-cam-id { font-size: 9px; color: rgba(255, 255, 255, 0.92); margin: 4px 0 0 8px; }
/* construction monitoring: the buildings of a complex, the investor panel */
.mon-objs { margin-bottom: 6px; flex-wrap: wrap; justify-content: center; }
.mon-obj { flex-direction: row; align-items: center; padding: 4px 10px 4px 8px; }
.mon-obj .dot { margin-right: 6px; }
.mon-obj-p { margin-left: 6px; font-size: 11px; color: var(--muted); }
.mon-seg .btn.active .mon-obj-p { color: #3a3a3a; }
.mon-opin Label { white-space: nowrap; font-size: 11px; padding: 3px 8px 3px 8px; background-color: rgba(16, 16, 16, 0.92); color: var(--text); border-width: 1px; border-color: var(--line2); border-radius: 6px; }
.mon-opin .mon-stem { height: 16px; width: 1px; background-color: rgba(255, 255, 255, 0.55); }
.mon-opin.sel Label { background-color: rgba(250, 250, 250, 0.96); color: #111111; }
.mon-opin:hover Label { border-color: var(--text2); }
.mon-td.m { width: 64px; -unity-text-align: upper-right; font-size: 11px; flex-shrink: 0; }
.mon-tr.sel { background-color: rgba(91, 141, 239, 0.12); }
.mon-g-sum .mon-g-label { -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.mon-inv { height: 58%; max-height: 58%; }
.mon-inv-kpis { flex-direction: row; margin: 4px 0 10px 0; flex-shrink: 0; }
.mon-inv-k { flex-grow: 1; flex-basis: 0; margin-right: 8px; padding: 8px 12px 8px 12px; border-radius: 8px; background-color: #1a1a1a; }
.mon-inv-cap { font-size: 10px; color: var(--muted); }
.mon-inv-val { font-size: 22px; color: var(--text); -unity-font-definition: url("Fonts/Geologica-Light.ttf"); }
.mon-inv-val.warn { color: var(--warn); }
.mon-inv-val.bad { color: var(--bad); }
.mon-inv-sub { font-size: 10px; color: var(--text2); white-space: normal; }
.mon-inv-body { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 0; }
.mon-inv-table { flex-grow: 1.5; flex-basis: 0; margin-right: 14px; overflow: hidden; }
.mon-inv-tr { flex-direction: row; align-items: flex-start; padding: 5px 0 5px 8px; border-left-width: 2px; border-left-color: rgba(0, 0, 0, 0); border-bottom-width: 1px; border-bottom-color: var(--line); flex-shrink: 0; }
.mon-inv-tr.ok { border-left-color: var(--ok); }
.mon-inv-tr.warn { border-left-color: var(--warn); }
.mon-inv-tr.bad { border-left-color: var(--bad); }
.mon-inv-tr.sel { background-color: rgba(91, 141, 239, 0.12); }
.mon-inv-tr:hover { background-color: rgba(255, 255, 255, 0.04); }
.mon-inv-tr .mon-td { font-size: 11px; }
.mon-td.o { flex-grow: 1.2; flex-basis: 0; min-width: 0; padding-right: 8px; }
.mon-td.b { width: 64px; flex-shrink: 0; }
.mon-td.r { width: 116px; flex-shrink: 0; padding-right: 14px; }
.mon-td.e { width: 150px; flex-shrink: 0; padding-right: 8px; }
.mon-td.c { flex-grow: 1; flex-basis: 0; min-width: 0; color: var(--text2); white-space: normal; }
.mon-inv-n { font-size: 12px; margin-bottom: 3px; }
.mon-inv-chartbox { flex-grow: 1; flex-basis: 0; }
.mon-inv-chart { flex-grow: 1; min-height: 120px; margin-top: 6px; position: relative; }
.mon-inv-mk { position: absolute; font-size: 9px; color: var(--text2); translate: -50% 0; }
/* construction monitoring laid out like the qTwin construction platform: a rail of sections, pages over the live picture */
.mon-head { height: 50px; }
.mon-crumbs { flex-direction: row; align-items: center; }
.mon-crumbs Label { font-size: 13px; color: var(--text2); }
.mon-crumbs .sep { margin: 0 8px 0 8px; color: var(--muted); }
.mon-crumbs .cur { color: var(--text); -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.mon-hdate { font-size: 12px; color: var(--text2); margin-right: 12px; }
.mon-pill Label { font-size: 11px; color: var(--text2); -unity-font-definition: url("Fonts/Geologica-Regular.ttf"); }
.mon-head .mon-pill { padding: 4px 10px 4px 9px; }
.mon-main { flex-direction: row; flex-grow: 1; }
.mon-rail { width: 76px; flex-shrink: 0; padding-top: 8px; border-right-width: 1px; border-right-color: var(--line); background-color: #0d0d0d; align-items: center; }
.mon-rail-b { width: 64px; height: 58px; margin: 0 0 4px 0; padding: 6px 0 4px 0; align-items: center; justify-content: center; border-width: 0; border-radius: 9px;
    background-color: rgba(0, 0, 0, 0); background-image: none; }
.mon-rail-b Label { font-size: 10px; color: var(--muted); margin-top: 4px; }
.mon-rail-b:hover { background-color: #1a1a1a; }
.mon-rail-b.on { background-color: #202020; }
.mon-rail-b.on Label { color: var(--text); }
.mon-rail-b.on .icon { -unity-background-image-tint-color: #ffffff; }
.mon-left { width: 336px; }
.mon-right { width: 372px; }
.mon-right-in { right: 66px; }
.mon-tsurv .mon-top { right: 452px; }
.mon-top { left: 360px; right: 396px; }
.mon-t4d .mon-col { bottom: 184px; }
.mon-tab-g .mon-col { bottom: 64%; }
.mon-bignum { font-size: 30px; margin-top: 6px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); }
.mon-para.warn { color: var(--warn); }
/* Объект: notifications, the toolbar under the picture */
.mon-note { flex-direction: row; align-items: center; padding: 8px 0 8px 0; border-bottom-width: 1px; border-bottom-color: var(--line); }
.mon-note-ic { width: 30px; height: 30px; border-radius: 8px; align-items: center; justify-content: center; margin-right: 10px; flex-shrink: 0; }
.mon-note-tx { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 8px; }
.mon-note-tx > Label { font-size: 12px; white-space: normal; }
.mon-tools { padding: 4px; }
.mon-tool { width: auto; height: 40px; flex-direction: row; padding: 0 12px 0 10px; margin: 0 1px 0 1px; border-width: 0; border-radius: 7px; background-color: rgba(0, 0, 0, 0); background-image: none; }
.mon-tool Label { margin-left: 7px; font-size: 12px; color: var(--text2); }
.mon-tool:hover { background-color: var(--panel3); }
.mon-tool:hover Label { color: var(--text); }
/* Съёмки: comparison, layers, tools, the bar of dates, the chronology, marks of the plan */
.mon-cmp { position: absolute; left: 0; top: 0; bottom: 0; overflow: hidden; }
.mon-cmp-img { position: absolute; left: 0; top: 0; }
.mon-div { position: absolute; top: 0; bottom: 0; width: 56px; margin-left: -28px; align-items: center; justify-content: center; overflow: visible; }
.mon-div-line { position: absolute; top: 0; bottom: 0; left: 27px; width: 2px; background-color: #ffffff; }
.mon-div-h { width: 38px; height: 38px; border-radius: 19px; background-color: #ffffff; color: #111111; -unity-text-align: middle-center; font-size: 13px;
    -unity-font-definition: url("Fonts/Geologica-SemiBold.ttf"); flex-shrink: 0; }
.mon-chip { position: absolute; top: 12px; padding: 4px 10px 4px 10px; border-radius: 6px; background-color: rgba(10, 10, 10, 0.86); border-width: 1px; border-color: var(--line2); font-size: 12px; }
.mon-chip.cur { border-color: #8e5cff; }
.mon-drop { flex-direction: row; align-items: center; margin: 0; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); background-image: none; }
.mon-tgl { flex-direction: row; align-items: center; margin: 0; padding: 6px 2px 6px 2px; border-width: 0; border-radius: 6px; background-color: rgba(0, 0, 0, 0); background-image: none; }
.mon-tgl:hover { background-color: #1c1c1c; }
.mon-tgl Label { font-size: 12px; color: var(--text2); margin-left: 9px; }
.mon-tgl-box { width: 15px; height: 15px; border-radius: 4px; border-width: 1px; border-color: var(--line2); background-color: #151515; }
.mon-tgl.on .mon-tgl-box { background-color: #5b8def; border-color: #5b8def; }
.mon-tgl.on Label { color: var(--text); }
.mon-ztiles { flex-direction: row; margin-top: 10px; }
.mon-ztile { flex-grow: 1; flex-basis: 0; margin-right: 6px; padding: 7px 10px 7px 10px; border-radius: 8px; background-color: #1a1a1a; }
.mon-ztile Label { font-size: 10px; color: var(--muted); }
.mon-ztile .v { font-size: 17px; color: var(--text); margin-top: 2px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); }
.mon-ztile .v.bad { color: var(--bad); }
.mon-ztile .v.ok { color: var(--ok); }
.mon-svtools { position: absolute; right: 12px; top: 12px; padding: 4px; border-radius: 10px; background-color: rgba(16, 16, 16, 0.94); border-width: 1px; border-color: var(--line); }
.mon-svtool { width: 38px; height: 38px; margin: 1px 0 1px 0; padding: 0; align-items: center; justify-content: center; border-width: 0; border-radius: 7px; background-color: rgba(0, 0, 0, 0); background-image: none; }
.mon-svtool:hover { background-color: var(--panel3); }
.mon-svtool.on { background-color: #2c2c2c; }
.mon-svtool.on .icon { -unity-background-image-tint-color: #ffffff; }
.mon-svbar { position: absolute; left: 12px; right: 12px; bottom: 12px; height: 50px; flex-direction: row; align-items: center; padding: 0 8px 0 14px; border-radius: 10px;
    background-color: rgba(16, 16, 16, 0.96); border-width: 1px; border-color: var(--line); }
.mon-svbar-k { font-size: 12px; color: var(--muted); margin-right: 10px; }
/* "Что изменилось": the diff of two surveys, like a diff before a push (+ blue, − red) */
.mon-svbar-sep { width: 1px; height: 26px; background-color: var(--line2); margin: 0 14px 0 12px; }
.mon-gitbtn { flex-direction: row; align-items: center; margin: 0; padding: 6px 12px 6px 9px; border-radius: 7px; border-width: 1px; border-color: var(--line2); background-color: #191919; background-image: none; }
.mon-gitbtn:hover { border-color: #5b8def; }
.mon-gitbtn > Label { font-size: 12px; margin-left: 4px; color: var(--text2); }
.mon-gitbtn .mon-git-p { margin-left: 9px; color: #4f8dff; -unity-font-style: bold; font-size: 14px; }
.mon-gitbtn .mon-git-m { margin-left: 1px; margin-right: 3px; color: #ff4a3d; -unity-font-style: bold; font-size: 14px; }
.mon-gitbtn.on { border-color: #4f8dff; background-color: rgba(79, 141, 255, 0.14); }
.mon-gitbtn.on > Label { color: var(--text); }
.mon-gitbtn.on .mon-tgl-box { background-color: #4f8dff; border-color: #4f8dff; }
.mon-gitleg { position: absolute; bottom: 74px; left: 50%; translate: -50% 0; padding: 10px 14px 11px 14px; border-radius: 10px;
    background-color: rgba(12, 13, 16, 0.94); border-width: 1px; border-color: var(--line2); }
.mon-gitleg-h { flex-direction: row; align-items: center; }
.mon-gitleg-t { font-size: 10px; letter-spacing: 1.2px; color: var(--muted); -unity-font-style: bold; margin-right: 14px; }
.mon-gitleg-stat { flex-direction: row; align-items: center; flex-wrap: wrap; }
.mon-gitleg-stat Label { font-size: 12px; -unity-font-style: bold; padding: 2px 7px 2px 7px; margin-left: 5px; border-radius: 5px; }
.mon-gitleg-stat .plus { color: #7fb0ff; background-color: rgba(79, 141, 255, 0.16); }
.mon-gitleg-stat .minus { color: #ff7a6e; background-color: rgba(255, 74, 61, 0.16); }
.mon-gitleg-k { flex-direction: row; align-items: center; margin-top: 9px; }
.mon-gitleg-i { flex-direction: row; align-items: center; margin-right: 16px; }
.mon-gitleg-i Label { font-size: 11px; color: var(--text2); margin-left: 6px; }
.mon-gitleg-sw { width: 12px; height: 12px; border-radius: 3px; }
.mon-gitleg-sw.add { background-color: #2a75ff; }
.mon-gitleg-sw.fin { background-color: #8cc8ff; }
.mon-gitleg-sw.del { background-color: #ff4a3d; }
.mon-gitleg-sw.same { background-color: #6a6d72; }
.mon-gitleg-n { font-size: 11px; color: var(--text2); margin-top: 8px; }
.mon-table.git .mon-td.d.ok { color: #7fb0ff; }
.mon-tr.git-add .mon-work { color: #7fb0ff; }
.mon-tr.git-del .mon-work { color: #ff7a6e; }
.mon-tr.git-del { background-color: rgba(255, 74, 61, 0.07); border-left-color: #ff4a3d; }
.mon-tr.git-add { background-color: rgba(79, 141, 255, 0.07); border-left-color: #4f8dff; }
.mon-dchip { flex-direction: row; align-items: center; margin: 0; padding: 6px 11px 6px 9px; border-radius: 7px; border-width: 1px; border-color: var(--line2); background-color: #191919; background-image: none; }
.mon-dchip:hover { border-color: var(--text2); }
.mon-dchip Label { margin-left: 7px; font-size: 12px; }
.mon-dchip.cur { border-color: #8e5cff; }
.mon-attrib { font-size: 10px; color: var(--muted); margin-right: 12px; }
.mon-chrono { position: absolute; right: 12px; bottom: 70px; width: 380px; max-height: 70%; padding: 10px 10px 6px 10px; border-radius: 10px; overflow: hidden;
    background-color: rgba(16, 16, 16, 0.98); border-width: 1px; border-color: var(--line2); }
.mon-chrono.left { right: auto; left: 12px; }
.mon-chrono-r { flex-direction: row; align-items: center; margin: 4px 0 0 0; padding: 7px 10px 7px 10px; border-radius: 7px; border-width: 1px; border-color: rgba(0, 0, 0, 0);
    background-color: #161616; background-image: none; -unity-text-align: middle-left; }
.mon-chrono-r:hover { border-color: var(--line2); }
.mon-chrono-r.a { border-color: #8e5cff; }
.mon-chrono-r.b { border-color: #5b8def; }
.mon-gcp { position: absolute; font-size: 10px; padding: 1px 5px 1px 5px; border-radius: 4px; background-color: rgba(120, 60, 200, 0.85); color: #ffffff; }
.mon-diff { position: absolute; translate: -50% -100%; white-space: nowrap; font-size: 11px; padding: 3px 8px 3px 8px; border-radius: 6px;
    background-color: rgba(16, 16, 16, 0.92); border-width: 1px; border-color: var(--line2); }
.mon-diff.up { border-color: var(--ok); }
.mon-ruler { position: absolute; translate: -50% 0; font-size: 12px; padding: 3px 8px 3px 8px; border-radius: 6px; background-color: #ffffff; color: #111111;
    -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
/* 4D: tiles of the buildings, KPI tiles, readiness by stages, the stage columns */
.mon-tiles { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.mon-tile { width: 49%; margin: 0 0 6px 0; padding: 7px 10px 7px 10px; border-radius: 8px; border-width: 1px; border-color: var(--line); background-color: #171717; background-image: none; align-items: stretch; }
.mon-tile:hover { border-color: var(--line2); }
.mon-tile.on { border-color: #5b8def; background-color: rgba(91, 141, 239, 0.12); }
.mon-tile-n { font-size: 11px; color: var(--text2); }
.mon-tile-p { font-size: 18px; margin-top: 2px; -unity-text-align: middle-left; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); }
.mon-wide { flex-direction: row; align-items: center; justify-content: center; height: 38px; margin: 0 0 10px 0; border-radius: 9px; border-width: 1px; border-color: var(--line2);
    background-color: rgba(16, 16, 16, 0.94); background-image: none; flex-shrink: 0; }
.mon-wide Label { margin-left: 8px; font-size: 13px; }
.mon-wide:hover { border-color: var(--text2); }
.mon-wide.on { background-color: var(--text); }
.mon-wide.on Label { color: #0a0a0a; }
.mon-wide.on .icon { -unity-background-image-tint-color: #0a0a0a; }
.mon-kgrid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; flex-shrink: 0; }
.mon-kt { width: 49%; margin-bottom: 7px; padding: 8px 11px 8px 11px; border-radius: 9px; background-color: rgba(22, 22, 22, 0.95); border-width: 1px; border-color: var(--line); }
.mon-kt.bad { background-color: rgba(120, 24, 20, 0.55); border-color: rgba(255, 59, 47, 0.6); }
.mon-kt-v { font-size: 20px; color: var(--text); -unity-font-definition: url("Fonts/Geologica-Light.ttf"); }
.mon-kt-v.ok { color: var(--ok); }
.mon-kt-v.warn { color: var(--warn); }
.mon-kt-v.bad { color: #ff7a70; }
.mon-st { padding: 5px 6px 6px 6px; border-radius: 6px; border-left-width: 2px; border-left-color: rgba(0, 0, 0, 0); }
.mon-st:hover { background-color: #1a1a1a; }
.mon-st.sel { background-color: rgba(91, 141, 239, 0.14); }
.mon-st.done { border-left-color: var(--ok); }
.mon-st.now { border-left-color: #5b8def; }
.mon-st.done .mon-fill { background-color: var(--ok); }
.mon-st-n { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mon-st-d { font-size: 10px; color: var(--muted); margin: 0 6px 0 6px; }
.mon-st-d.ok { color: var(--ok); }
.mon-st-d.warn { color: var(--warn); }
.mon-st-d.bad { color: var(--bad); }
.mon-st-p { font-size: 11px; width: 36px; -unity-text-align: middle-right; }
.mon-stg { position: absolute; left: 12px; right: 12px; bottom: 74px; height: 98px; padding: 8px 12px 8px 12px; border-radius: 10px;
    background-color: rgba(14, 14, 14, 0.95); border-width: 1px; border-color: var(--line); }
.mon-stg .legend-item { margin-left: 12px; margin-bottom: 0; }
.mon-stg-t { font-size: 12px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.mon-stg-row { flex-direction: row; flex-grow: 1; margin-top: 6px; }
.mon-stg-c { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 4px; padding: 5px 7px 6px 7px; border-radius: 6px; background-color: #171717; border-width: 1px; border-color: rgba(0, 0, 0, 0); justify-content: space-between; }
.mon-stg-c:hover { border-color: var(--line2); }
.mon-stg-c.sel { border-color: #5b8def; }
.mon-stg-c.done { background-color: rgba(52, 199, 89, 0.12); }
.mon-stg-c.now { background-color: rgba(91, 141, 239, 0.16); }
.mon-stg-n { font-size: 10px; color: var(--text2); white-space: normal; overflow: hidden; max-height: 26px; }
.mon-stg-p { font-size: 13px; margin-top: 2px; }
.mon-stg-bar { height: 4px; background-color: #2e2e2e; margin-top: 3px; }
.mon-stg-fill { height: 4px; background-color: #5b8def; }
.mon-stg-c.done .mon-stg-fill { background-color: var(--ok); }
.mon-g-crew { font-size: 11px; color: var(--text2); margin-left: 14px; }
/* Видео: the camera wall */
.mon-vid { position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: row; background-color: #070707; }
.mon-vid-side { width: 210px; flex-shrink: 0; padding: 12px 10px 12px 10px; border-right-width: 1px; border-right-color: var(--line); background-color: #0c0c0c; }
.mon-vid-item { flex-direction: row; align-items: center; margin: 0 0 2px 0; padding: 8px 10px 8px 10px; border-width: 0; border-radius: 7px; background-color: rgba(0, 0, 0, 0); background-image: none; }
.mon-vid-item Label { margin-left: 9px; font-size: 12px; color: var(--text2); }
.mon-vid-item:hover { background-color: #191919; }
.mon-vid-item.on { background-color: #222222; }
.mon-vid-item.on Label { color: var(--text); }
.mon-vid-gh { flex-direction: row; align-items: center; margin: 14px 4px 6px 10px; }
.mon-vid-gh Label { font-size: 10px; color: var(--muted); letter-spacing: 0.6px; }
.mon-vid-sep { height: 1px; background-color: var(--line); margin: 12px 4px 12px 4px; }
.mon-vid-main { flex-grow: 1; padding: 12px; }
.mon-vid-ev { padding: 10px 14px 10px 14px; border-radius: 10px; background-color: #111111; border-width: 1px; border-color: var(--line); margin-bottom: 12px; flex-shrink: 0; }
.mon-vid-info { padding: 16px; border-radius: 10px; background-color: #111111; border-width: 1px; border-color: var(--line); color: var(--text2); font-size: 13px; white-space: normal; }
.mon-vid-grid { flex-grow: 1; flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-content: flex-start; }
.mon-vcam { width: 32.8%; height: 47%; margin-bottom: 10px; border-radius: 8px; overflow: hidden; background-color: #000000; border-width: 1px; border-color: var(--line); position: relative; }
.mon-vid-grid.few .mon-vcam { width: 49.6%; height: 70%; }
.mon-vcam:hover { border-color: var(--text2); }
.mon-vchip { position: absolute; left: 10px; bottom: 10px; font-size: 11px; padding: 4px 9px 4px 9px; border-radius: 6px; background-color: rgba(10, 10, 10, 0.82); color: var(--text); }
.mon-cambar { position: absolute; left: 12px; right: 12px; top: 12px; height: 44px; flex-direction: row; align-items: center; padding: 0 12px 0 6px; border-radius: 10px;
    background-color: rgba(16, 16, 16, 0.94); border-width: 1px; border-color: var(--line); }
.mon-back { flex-direction: row; align-items: center; margin-right: 6px; }
.mon-back Label { margin-left: 6px; font-size: 12px; }
/* ---------- construction analytics (IconicMonitorAnalytics): the main thing, the money, the findings with their documents ---------- */
.an-page { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #080808; padding: 14px 18px 12px 18px; flex-direction: column; }
.an-page Button Label { -unity-text-align: middle-left; }
.an-head { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: 10px; }
.an-titles { margin-left: 10px; flex-shrink: 1; }
.an-h1 { font-size: 18px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.an-verdict { flex-shrink: 0; padding: 10px 16px 11px 14px; border-radius: 10px; border-width: 1px; border-color: var(--line); border-left-width: 4px; background-color: #121212; margin-bottom: 12px; }
.an-verdict.s-bad { border-left-color: var(--bad); background-color: rgba(255, 59, 47, 0.08); }
.an-verdict.s-warn { border-left-color: var(--warn); background-color: rgba(245, 166, 35, 0.07); }
.an-verdict.s-info { border-left-color: var(--info); }
.an-verdict.s-ok { border-left-color: var(--ok); }
.an-verdict-k { font-size: 10px; color: var(--muted); letter-spacing: 0.6px; }
.an-verdict-t { font-size: 16px; color: var(--text); margin-top: 3px; white-space: normal; }
.an-view { flex-grow: 1; flex-direction: column; min-height: 0; }
.an-kpis { flex-direction: row; flex-shrink: 0; margin-bottom: 12px; }
.an-k { flex-grow: 1; flex-basis: 0; margin: 0 8px 0 0; padding: 9px 12px 10px 12px; border-radius: 9px; background-color: #151515; border-width: 1px; border-color: var(--line); background-image: none; align-items: stretch; justify-content: flex-start; }
.an-k:hover { border-color: var(--line2); background-color: #1a1a1a; }
.an-k.k-bad { border-color: rgba(255, 59, 47, 0.55); background-color: rgba(120, 24, 20, 0.35); }
.an-k.k-warn { border-color: rgba(245, 166, 35, 0.5); }
.an-k Label { -unity-text-align: upper-left; white-space: normal; }
.an-k-v { font-size: 24px; color: var(--text); margin: 1px 0 1px 0; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); }
.an-k-v.bad { color: var(--bad); }
.an-k-v.warn { color: var(--warn); }
.an-k-v.ok { color: var(--ok); }
.an-row { flex-direction: row; flex-grow: 1; min-height: 0; }
.an-colL { flex-grow: 1.45; flex-basis: 0; min-width: 0; margin-right: 14px; flex-direction: column; }
.an-colR { flex-grow: 1; flex-basis: 0; min-width: 0; }
.an-colW { flex-grow: 1; flex-direction: column; min-width: 0; }
.an-sec { flex-direction: row; align-items: center; flex-shrink: 0; }
.an-count { font-size: 11px; padding: 2px 8px 2px 8px; border-radius: 10px; margin-left: 6px; }
.an-count.s-bad { color: #ffb3ad; background-color: rgba(255, 59, 47, 0.18); }
.an-count.s-warn { color: #ffd38a; background-color: rgba(245, 166, 35, 0.16); }
.an-hint { margin: 3px 0 8px 0; flex-shrink: 0; }
.an-scroll .unity-scroll-view__content-container { padding: 0 6px 4px 0; }
.an-scroll .unity-scroller--vertical { width: 6px; border-width: 0; background-color: rgba(0, 0, 0, 0); margin-left: 2px; }
.an-scroll .unity-scroller--vertical .unity-base-slider__dragger { background-color: #3a3a3a; border-radius: 3px; width: 4px; border-width: 0; left: 1px; }
.an-scroll .unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.an-scroll .unity-scroller__low-button, .an-scroll .unity-scroller__high-button { display: none; }
.an-flist { flex-grow: 1; }
.an-f { padding: 10px 12px 10px 12px; margin-bottom: 8px; border-radius: 9px; background-color: #121212; border-width: 1px; border-color: var(--line); border-left-width: 3px; }
.an-f.s-bad { border-left-color: var(--bad); }
.an-f.s-warn { border-left-color: var(--warn); }
.an-f.s-info { border-left-color: var(--info); }
.an-f.s-ok { border-left-color: var(--ok); background-color: #0e0e0e; }
.an-f-top { flex-direction: row; align-items: flex-start; }
.an-f-t { flex-grow: 1; flex-shrink: 1; font-size: 13px; margin-left: 8px; margin-right: 8px; white-space: normal; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.an-tag { font-size: 10px; padding: 2px 7px 2px 7px; border-radius: 4px; flex-shrink: 0; }
.an-tag.s-bad { color: #ffb3ad; background-color: rgba(255, 59, 47, 0.18); }
.an-tag.s-warn { color: #ffd38a; background-color: rgba(245, 166, 35, 0.16); }
.an-tag.s-info { color: #b8cdff; background-color: rgba(122, 167, 255, 0.14); }
.an-tag.s-ok { color: #9be3b0; background-color: rgba(52, 199, 89, 0.14); }
.an-f-x { font-size: 12px; color: var(--text2); margin: 4px 0 0 24px; white-space: normal; }
.an-f-src { flex-direction: row; flex-wrap: wrap; align-items: center; margin: 7px 0 0 24px; }
.an-card .an-f-src { margin-left: 0; }
.an-why { font-size: 10px; color: var(--muted); margin-right: 6px; }
.an-chip { flex-direction: row; align-items: center; margin: 2px 5px 2px 0; padding: 3px 8px 3px 6px; border-radius: 5px; border-width: 1px; border-color: #4f421f; background-color: rgba(245, 190, 40, 0.08); background-image: none; }
.an-chip Label { font-size: 11px; color: #f3d27a; margin-left: 5px; }
.an-chip .icon { -unity-background-image-tint-color: #f3d27a; }
.an-chip:hover { background-color: rgba(245, 190, 40, 0.2); border-color: #f3d27a; }
.an-go { flex-direction: row; align-items: center; margin: 2px 0 2px 8px; padding: 3px 8px 3px 8px; border-width: 0; border-radius: 5px; background-color: rgba(0, 0, 0, 0); background-image: none; }
.an-go Label { font-size: 11px; color: var(--text2); margin-right: 5px; }
.an-go:hover { background-color: #1f1f1f; }
.an-card { margin-bottom: 10px; }
.an-card .mon-title { white-space: nowrap; }
.an-ib { background-color: rgba(0, 0, 0, 0); border-width: 0; background-image: none; padding: 6px 4px 6px 4px; margin: 0; border-radius: 6px; align-items: stretch; }
.an-ib:hover { background-color: #1a1a1a; }
.an-ib-top { flex-direction: row; justify-content: space-between; }
.an-ib-n { font-size: 12px; color: var(--text); flex-shrink: 1; }
.an-ib-d { font-size: 12px; flex-shrink: 0; margin-left: 8px; }
.an-ib-d.bad, .an-ctd.bad, .an-big-v.bad, .an-step-v.bad, .an-res-d.bad { color: var(--bad); }
.an-ib-d.warn, .an-ctd.warn, .an-big-v.warn, .an-step-v.warn, .an-res-d.warn { color: var(--warn); }
.an-ib-d.ok, .an-ctd.ok, .an-big-v.ok, .an-step-v.ok, .an-res-d.ok { color: var(--ok); }
.an-bb { height: 6px; background-color: #222222; border-radius: 3px; margin-top: 5px; }
.an-bb-ac { position: absolute; left: 0; top: 0; bottom: 0; background-color: #5b8def; border-top-left-radius: 3px; border-bottom-left-radius: 3px; }
.an-bb-etc { position: absolute; top: 0; bottom: 0; background-color: rgba(255, 255, 255, 0.28); }
.an-bb-over { position: absolute; top: 0; bottom: 0; background-color: rgba(255, 74, 61, 0.85); }
.an-bb-b { position: absolute; top: -3px; bottom: -3px; width: 2px; background-color: #ffffff; }
.an-doc { flex-direction: row; align-items: center; padding: 8px 10px 8px 8px; margin: 0 0 5px 0; border-radius: 8px; border-width: 1px; border-color: var(--line); background-color: #121212; background-image: none; }
.an-doc.compact { padding: 6px 6px 6px 4px; border-width: 0; background-color: rgba(0, 0, 0, 0); margin: 0; }
.an-doc:hover { background-color: #1b1b1b; }
.an-doc-ic { width: 30px; height: 30px; border-radius: 7px; background-color: #1f1f1f; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 10px; }
.an-doc-tx { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.an-doc-t { font-size: 12px; color: var(--text); white-space: normal; }
.an-doc-refs { font-size: 10px; color: #f3d27a; background-color: rgba(245, 190, 40, 0.12); padding: 2px 7px 2px 7px; border-radius: 9px; margin-left: 8px; flex-shrink: 0; }
.an-stars { flex-direction: row; margin-left: 12px; flex-shrink: 0; }
.an-star { width: 7px; height: 7px; border-radius: 4px; background-color: #333333; margin-left: 3px; }
.an-star.on { background-color: #f5a623; }
.an-dgroup { margin: 10px 0 6px 2px; }
.an-dgroup-t { font-size: 11px; color: var(--muted); letter-spacing: 0.8px; }
.an-dlist { flex-grow: 1; }
.an-tools { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: 10px; }
.an-tools .legend-item { margin-left: 12px; margin-right: 0; margin-bottom: 0; }
.an-ctab { flex-grow: 1; min-height: 0; background-color: #101010; border-width: 1px; border-color: var(--line); border-radius: 10px; padding: 6px 10px 6px 10px; flex-direction: column; }
.an-ctr { flex-direction: row; align-items: center; padding: 7px 4px 7px 4px; margin: 0; border-width: 0; border-bottom-width: 1px; border-bottom-color: var(--line); border-radius: 0; background-color: rgba(0, 0, 0, 0); background-image: none; flex-shrink: 0; }
.an-ctr:hover { background-color: #181818; }
.an-ctr.sel { background-color: rgba(91, 141, 239, 0.14); }
.an-cth Label { font-size: 10px; color: var(--muted); }
.an-ctd { font-size: 12px; }
.an-ctd.n { flex-grow: 1; flex-basis: 0; min-width: 0; padding-right: 8px; white-space: normal; }
.an-ctd.m { width: 84px; flex-shrink: 0; -unity-text-align: middle-right; }
.an-ctd.w { width: 140px; flex-shrink: 0; -unity-text-align: middle-right; }
.an-ctd.s { width: 76px; flex-shrink: 0; -unity-text-align: middle-right; }
.an-ctd.bar { width: 150px; flex-shrink: 0; margin-left: 16px; }
.an-ctot { border-top-width: 1px; border-top-color: var(--line2); }
.an-ctot Label { -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.an-note { font-size: 10px; color: var(--muted); white-space: normal; }
.an-crows { flex-grow: 1; }
.an-prices { margin-top: 10px; margin-bottom: 0; flex-shrink: 0; }
.an-ptab { margin-top: 6px; }
.an-ptr { flex-direction: row; align-items: center; padding: 4px 0 4px 0; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.05); }
.an-big { margin: 8px 0 4px 0; }
.an-big-v { font-size: 28px; -unity-font-definition: url("Fonts/Geologica-Light.ttf"); }
.an-step { flex-direction: row; align-items: center; padding: 7px 0 7px 0; border-bottom-width: 1px; border-bottom-color: var(--line); }
.an-step-n { width: 22px; height: 22px; border-radius: 11px; background-color: #1f1f1f; -unity-text-align: middle-center; font-size: 11px; color: var(--text2); flex-shrink: 0; margin-right: 10px; }
.an-step-tx { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.an-step-k { font-size: 12px; white-space: normal; }
.an-step-v { font-size: 13px; margin-left: 10px; flex-shrink: 0; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.an-res { flex-direction: row; align-items: center; padding: 6px 0 6px 0; border-bottom-width: 1px; border-bottom-color: var(--line); }
.an-res-tx { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.an-res-n { font-size: 12px; white-space: normal; }
.an-res-v { align-items: flex-end; flex-shrink: 0; margin-left: 10px; }
.an-res-p { font-size: 12px; }
.an-res-d { font-size: 11px; }
.an-viewer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: row; }
.an-vdim { flex-grow: 1; background-color: rgba(0, 0, 0, 0.6); }
.an-vsheet { width: 58%; background-color: #161616; border-left-width: 1px; border-left-color: var(--line2); flex-direction: column; }
.an-vbar { flex-direction: row; align-items: center; padding: 10px 12px 10px 14px; border-bottom-width: 1px; border-bottom-color: var(--line); flex-shrink: 0; }
.an-vtitles { margin-left: 10px; flex-shrink: 1; min-width: 0; }
.an-vtitle { font-size: 14px; white-space: normal; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.an-vnav { font-size: 11px; color: #f3d27a; margin: 0 6px 0 10px; }
.an-vbtn { width: 26px; height: 26px; padding: 0; margin: 0 0 0 4px; border-radius: 6px; align-items: center; justify-content: center; background-color: #222222; border-width: 1px; border-color: var(--line2); background-image: none; }
.an-vbtn:hover { border-color: var(--text2); }
.an-vctx { flex-direction: row; align-items: center; padding: 7px 14px 7px 14px; background-color: rgba(245, 166, 35, 0.1); border-bottom-width: 1px; border-bottom-color: rgba(245, 166, 35, 0.3); flex-shrink: 0; }
.an-vctx .icon { -unity-background-image-tint-color: #f5a623; flex-shrink: 0; }
.an-vctx-t { font-size: 12px; color: #ffd38a; margin-left: 8px; white-space: normal; flex-shrink: 1; }
.an-vscroll { flex-grow: 1; background-color: #2b2b2b; }
.an-paper { margin: 18px 22px 24px 22px; padding: 34px 40px 40px 40px; background-color: #f6f4ef; border-radius: 3px; }
.an-paper Label { color: #1c1c1c; white-space: normal; }
.an-paper .an-pk { font-size: 10px; color: #8a8478; letter-spacing: 1.2px; }
.an-ph1 { font-size: 19px; margin-top: 4px; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.an-paper .an-pmeta { font-size: 11px; color: #6b665c; margin-top: 3px; }
.an-prule { height: 1px; background-color: #d8d3c8; margin: 14px 0 10px 0; }
.an-ph2 { font-size: 13px; margin: 14px 0 6px 0; -unity-font-definition: url("Fonts/Geologica-Medium.ttf"); }
.an-pp-t { font-size: 13px; }
.an-pp { margin: 3px 0 3px 0; padding: 5px 8px 5px 8px; border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0); border-radius: 2px; }
.an-ptr2 { flex-direction: row; padding: 5px 8px 5px 8px; border-bottom-width: 1px; border-bottom-color: #e2ddd2; border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0); }
.an-ptr2.head { border-bottom-color: #b9b2a3; }
.an-paper .an-ptr2.head Label { color: #6b665c; font-size: 10px; }
.an-pc { font-size: 11px; padding-right: 6px; -unity-text-align: upper-right; }
.an-pc.first { -unity-text-align: upper-left; }
.an-paper .an-psign { margin-top: 26px; font-size: 12px; color: #444444; }
.an-blk { transition-property: background-color; transition-duration: 0.5s; }
.an-blk.ref { background-color: rgba(255, 214, 64, 0.24); border-left-color: rgba(230, 170, 30, 0.6); }
.an-blk.hl { background-color: rgba(255, 210, 50, 0.62); border-left-color: #e08a00; }
.an-blk.hl.flash { background-color: rgba(255, 160, 0, 0.95); }
.an-paper .an-hltag { right: 8px; top: -9px; font-size: 10px; color: #ffffff; background-color: #e08a00; padding: 1px 6px 1px 6px; border-radius: 4px; }
.an-blk.ref .an-hltag { display: none; }
