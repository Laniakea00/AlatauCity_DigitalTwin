+            else:
+                by_street[s["street"]] = s["id"]
+        P = s["pts"]
+        for nd, p0, p1 in ((s["a"], P[0], P[1]), (s["b"], P[-1], P[-2])):
+            ends[nd].append((math.atan2(p1[1] - p0[1], p1[0] - p0[0]), s["id"]))
